[project]
title = Microvania Toolkit (Defold)
version = 0.1.0-beta.5
custom_resources = /developer/config, /developer/runtime, /developer/rooms/generated, /developer/assets/tiled/maps, /developer/assets/minimap, /developer/tools
bundle_resources = /developer/assets/cutscenes
dependencies#0 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.7.zip
dependencies#1 = https://github.com/britzl/defold-screenshot/archive/refs/tags/1.13.0.zip
dependencies#2 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip
dependencies#3 = https://github.com/defold/extension-videoplayer-native/archive/refs/tags/1.4.0.zip

[bootstrap]
main_collection = /mvtk/boot/start.collectionc
render = /renderer/default.renderc

[input]
game_binding = /developer/input/game.input_bindingc
gamepad_database = /builtins/input/gamecontrollerdb.txt
gamepad_deadzone = 0.2

[display]
width = 1920
height = 1080
high_dpi = 1
vsync = 1

[physics]
gravity_y = -1600.0
debug = 0
debug_alpha = 0.4
debug_scale = 15.0
allow_dynamic_transforms = 1
use_fixed_timestep = 0
max_collision_object_count = 4096
max_collisions = 1024
max_contacts = 1024

[log]
log_level = INFO
use_file_logging = 0

[tilemap]
max_count = 128
max_tile_count = 16348

[sprite]
max_count = 1024

[box2d]
velocity_iterations = 20
position_iterations = 20
sub_step_count = 8

[engine]
fixed_update_frequency = 60

[resource]
max_resources = 32768

[collectionfactory]
max_count = 512

[collection]
max_instances = 4096

[factory]
max_count = 512

[graphics]
max_font_batches = 256
max_debug_vertices = 50000

[particle_fx]
max_count = 512
max_particle_buffer_count = 2048
max_particle_count = 2048

[sound]
max_component_count = 128
max_sound_instances = 128
group = master
group = sfx
group = music
group = ambient
