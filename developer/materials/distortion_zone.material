name: "distortion_zone"
tags: "sprite"
vertex_program: "/developer/materials/distortion_zone.vp"
fragment_program: "/developer/materials/distortion_zone.fp"
vertex_space: VERTEX_SPACE_WORLD
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.55
    y: 0.82
    z: 1.0
    w: 0.45
  }
}
fragment_constants {
  name: "distortion_params"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.005
    y: 0.04
    z: 0.0
    w: 0.55
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
