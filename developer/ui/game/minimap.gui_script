local function round_to_step(v, step)
    if not step or step <= 0 then return v end
    return math.floor(v / step + 0.5) * step
end
local function screen_size()
    -- The Fit root maps this design-space panel into the letterbox.
    return Viewport.design_size()
end

local function clamp(v, lo, hi)
    if lo > hi then
        lo, hi = hi, lo
    end
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

local function in_bounds(bounds, wx, wy, margin)
    if not bounds then return false end
    margin = margin or 0
    if wx < bounds.min_x - margin then return false end
    if wx > bounds.max_x + margin then return false end
    if wy < bounds.min_y - margin then return false end
    if wy > bounds.max_y + margin then return false end
    return true
end
local function normalize_room_id(id)
    if not id then return nil end
    local sid = tostring(id)
    if sid == '' then return nil end
    sid = sid:gsub('^/+', '')
    sid = sid:gsub('%.collection$', '')
    sid = sid:gsub('^developer/rooms/', '')
    return sid
end

local function ids_match(a, b)
    if not a or not b then return false end
    local na = normalize_room_id(a)
    local nb = normalize_room_id(b)
    if na and nb then
        return na == nb
    end
    return tostring(a) == tostring(b)
end

-- Debug helper: dump GUI node positions/sizes to find stray nodes (e.g., white box)
local function debug_dump_nodes(self, label)
    label = label or "minimap_debug"
    local nodes = {
        { id = "panel_container", node = self.panel_container },
        { id = "frame_node", node = self.frame_node },
        { id = "clip_node", node = self.clip_node },
        { id = "container", node = self.container },
        { id = "backdrop", node = self.backdrop },
        { id = "map_node", node = self.map_node },
        { id = "player_node", node = self.player_node },
    }
    print(string.format("[MINIMAP_DEBUG] === %s ===", label))
    for _, entry in ipairs(nodes) do
        local node = entry.node
        if node then
            local pos = gui.get_screen_position(node)
            local size = gui.get_size(node)
            local vis = gui.is_enabled(node)
            print(string.format("[MINIMAP_DEBUG] node=%-14s pos=(%.1f,%.1f) size=(%.1f,%.1f) visible=%s",
                tostring(entry.id),
                pos.x or 0, pos.y or 0,
                size.x or 0, size.y or 0,
                tostring(vis)))
        else
            print(string.format("[MINIMAP_DEBUG] node=%-14s missing", tostring(entry.id)))
        end
    end
end


-- Blend helpers (top-level)
local function lerp(a, b, t)
    return (a or 0) + (t or 0) * ((b or 0) - (a or 0))
end

local function equal_eps(a, b, eps)
    eps = eps or (CFG.seam_eps_world or 1.0)
    return math.abs((a or 0) - (b or 0)) <= eps
end

local function find_room_entry_for_point(px, py, rooms, margin, opts)
    if not rooms then return nil end
    margin = margin or 0
    opts = opts or {}

    -- Build a list of room ids we should prefer when multiple rooms overlap the test point
    local preferred = {}
    local function add_preferred(id)
        local nid = normalize_room_id(id)
        if not nid then return end
        for _, existing in ipairs(preferred) do
            if existing == nid then return end
        end
        preferred[#preferred + 1] = nid
    end

    if opts.preferred_ids then
        if type(opts.preferred_ids) == "table" then
            for _, id in ipairs(opts.preferred_ids) do
                add_preferred(id)
            end
        else
            add_preferred(opts.preferred_ids)
        end
    end
    if opts.preferred_id then
        add_preferred(opts.preferred_id)
    end

    local function preferred_rank(id)
        local nid = normalize_room_id(id)
        if not nid then return math.huge end
        for idx, pid in ipairs(preferred) do
            if pid == nid then
                return idx
            end
        end
        return math.huge
    end

    local best_entry, best_meta = nil, nil

    for _, entry in ipairs(rooms) do
        local r = entry and entry.r
        if r then
            local min_x = (r.min_x or 0) - margin
            local max_x = (r.max_x or 0) + margin
            local min_y = (r.min_y or 0) - margin
            local max_y = (r.max_y or 0) + margin

            if px >= min_x and px <= max_x and py >= min_y and py <= max_y then
                local actual_min_x = r.min_x or min_x
                local actual_max_x = r.max_x or max_x
                local actual_min_y = r.min_y or min_y
                local actual_max_y = r.max_y or max_y

                local inside_actual = (px >= actual_min_x and px <= actual_max_x and py >= actual_min_y and py <= actual_max_y)

                local dx = math.min(px - actual_min_x, actual_max_x - px)
                local dy = math.min(py - actual_min_y, actual_max_y - py)
                local distance = math.min(dx, dy)

                local priority = distance or 0
                if inside_actual then
                    priority = priority + 1000000 -- ensure true interior wins over margin overlap
                end

                local rank = preferred_rank(entry.id)
                local meta = {
                    inside_actual = inside_actual,
                    distance = distance,
                    priority = priority,
                    preferred_rank = rank,
                }

                if not best_meta or priority > best_meta.priority then
                    best_entry = entry
                    best_meta = meta
                elseif best_meta and math.abs(priority - best_meta.priority) <= 1e-6 then
                    local best_rank = best_meta.preferred_rank or math.huge
                    if rank < best_rank then
                        best_entry = entry
                        best_meta = meta
                    elseif rank == best_rank then
                        local best_distance = best_meta.distance or -math.huge
                        if (distance or -math.huge) > best_distance then
                            best_entry = entry
                            best_meta = meta
                        end
                    end
                end
            end
        end
    end

    if best_entry then
        return best_entry, best_meta
    end

    return nil, nil
end

local function find_neighbor_across_seam(seam_axis, seam_coord, side, rooms)
    if not rooms or not seam_axis or not seam_coord then return nil end
    local eps = CFG.seam_eps_world or 1.0
    for _, entry in ipairs(rooms) do
        local r = entry and entry.r
        if r then
            if seam_axis == 'x' then
                if (side == 'left'  and equal_eps(r.max_x, seam_coord, eps))
                or (side == 'right' and equal_eps(r.min_x, seam_coord, eps)) then
                    return entry
                end
            else
                if (side == 'bottom' and equal_eps(r.max_y, seam_coord, eps))
                or (side == 'top'    and equal_eps(r.min_y, seam_coord, eps)) then
                    return entry
                end
            end
        end
    end
    return nil
end

get_seam_contact = function(px, py, bounds, margin)
    if not bounds or not margin then return nil end
    if margin < 0 then return nil end
    local min_x, max_x = bounds.min_x, bounds.max_x
    local min_y, max_y = bounds.min_y, bounds.max_y
    local best, best_abs
    local function consider(axis, seam, side, signed_dist)
        local abs_dist = math.abs(signed_dist)
        if abs_dist <= margin and (not best_abs or abs_dist < best_abs) then
            best = { axis = axis, seam = seam, side = side, signed_dist = signed_dist }
            best_abs = abs_dist
        end
    end
    if py >= (min_y - margin) and py <= (max_y + margin) then
        consider("x", min_x, "left", px - min_x)
        consider("x", max_x, "right", px - max_x)
    end
    if px >= (min_x - margin) and px <= (max_x + margin) then
        consider("y", min_y, "bottom", py - min_y)
        consider("y", max_y, "top", py - max_y)
    end
    return best
end

-- Door-based freeze detection functions

-- Door data cache to avoid repeated message requests
local door_data_cache = {}
local door_data_pending = {}

-- Get stored door positions from the streaming system
local function get_door_positions_for_room(room_id)
    if not room_id then return {} end

    -- Check cache first
    if door_data_cache[room_id] then
        if CFG.debug and #door_data_cache[room_id] > 0 then
            minimap_log(string.format("[MINIMAP_DBG] Using cached door data for %s: %d doors", room_id, #door_data_cache[room_id]))
        end
        return door_data_cache[room_id]
    end

    -- If request is pending, return empty for now
    if door_data_pending[room_id] then
        if CFG.debug then
            minimap_log(string.format("[MINIMAP_DBG] Door data request pending for %s", room_id))
        end
        return {}
    end

    -- Request door data from stream manager
    local stream_manager_url = msg.url("main:/room_manager#script")
    door_data_pending[room_id] = true
    if CFG.debug then
        minimap_log(string.format("[MINIMAP_DBG] Requesting door data for %s from %s", room_id, tostring(stream_manager_url)))
    end
    msg.post(stream_manager_url, "get_door_data", { room_id = room_id })

    return {}
end

-- Handle door data response from stream manager
local function handle_door_data_response(message)
    if message and message.room_id then
        door_data_cache[message.room_id] = message.doors or {}
        door_data_pending[message.room_id] = nil
        if CFG.debug then
            local door_count = message.doors and #message.doors or 0
            minimap_log(string.format("[MINIMAP_DBG] Received door data for %s: %d doors", message.room_id, door_count))
            if door_count > 0 and message.doors then
                for i, door in ipairs(message.doors) do
                    if i <= 2 then  -- Only show first 2 doors to avoid spam
                        minimap_log(string.format("[MINIMAP_DBG]   Cached door %d: (%.1f,%.1f) locked=%s", i, door.x, door.y, tostring(door.locked)))
                    end
                end
            end
        end
    end
end

