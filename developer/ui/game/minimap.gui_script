local function deserialize_map(src, context)
    local loader = loadstring or load
    if not loader then
        minimap_log(string.format('[MINIMAP_LOAD] No loader available (%s)', context or 'unknown'))
        return nil
    end
    local chunk, compile_err = loader(src)
    if not chunk then
        minimap_log(string.format('[MINIMAP_LOAD] Compile failed (%s): %s', context or 'unknown', tostring(compile_err)))
        return nil
    end
    local ok_eval, data = pcall(chunk)
    if not ok_eval or type(data) ~= 'table' then
        minimap_log(string.format('[MINIMAP_LOAD] Eval failed (%s): %s', context or 'unknown', tostring(data)))
        return nil
    end
    return data
end

local function load_map_data(initial, context)
    if type(initial) == 'table' then
        return initial
    end
    if io and io.open then
        for _, disk_path in ipairs(DISK_SOURCE_PATHS) do
            local fh = io.open(disk_path, "r")
            if fh then
                local src = fh:read("*a")
                fh:close()
                if src and #src > 0 then
                    local data = deserialize_map(src, context or disk_path)
                    if data then
                        return data
                    end
                end
            end
        end
    end
    local ok_txt, src = pcall(sys.load_resource, SOURCE_PATH)
    if not ok_txt then
        minimap_log(string.format('[MINIMAP_LOAD] sys.load_resource failed (%s): %s', context or 'unknown', tostring(src)))
        return nil
    end
    if not src or #src == 0 then
        minimap_log(string.format('[MINIMAP_LOAD] Empty map resource (%s)', context or 'unknown'))
        return nil
    end
    return deserialize_map(src, context)
end

