-- Prefer CFG values over MapData (allows easy config without regenerating sprite)
local MAP_WIDTH = math.max(1, CFG.map_width or MapData.width or 1)
local MAP_HEIGHT = math.max(1, CFG.map_height or MapData.height or 1)
local world_min_x = (CFG.map_world_min and CFG.map_world_min.x) or (MapData.world_min and MapData.world_min.x) or 0
local world_min_y = (CFG.map_world_min and CFG.map_world_min.y) or (MapData.world_min and MapData.world_min.y) or 0
local world_max_x = (CFG.map_world_max and CFG.map_world_max.x) or (MapData.world_max and MapData.world_max.x) or (world_min_x + MAP_WIDTH)
local world_max_y = (CFG.map_world_max and CFG.map_world_max.y) or (MapData.world_max and MapData.world_max.y) or (world_min_y + MAP_HEIGHT)
local scale_x = (CFG.map_scale and CFG.map_scale.x) or (MapData.scale and MapData.scale.x) or (MAP_WIDTH / math.max(1, world_max_x - world_min_x))
local scale_y = (CFG.map_scale and CFG.map_scale.y) or (MapData.scale and MapData.scale.y) or (MAP_HEIGHT / math.max(1, world_max_y - world_min_y))
