local function minimap_log(...)
    if Debug.global.enable or Debug.minimap.load then
        print(...)
    end
end

local function minimap_debug_log(...)
    if Debug.global.enable or Debug.minimap.debug then
        print(...)
    end
end

local image_module_checked = false
local image_module = nil
local IMAGE_OPTIONS = { premultiply_alpha = false }

local function get_image_module()
    if not image_module_checked then
        image_module = rawget(_G, "image")
        if not image_module and type(require) == "function" then
            local ok, mod = pcall(require, "ima" .. "ge")
            if ok then
                image_module = mod
            end
        end
        image_module_checked = true
    end
    return image_module
end

local function decode_image(data)
    local mod = get_image_module()
    if not (mod and mod.load) then
        minimap_log('[MINIMAP_LOAD] image module unavailable; skipping dynamic texture refresh')
        return false, "image module unavailable"
    end
    return pcall(mod.load, data, IMAGE_OPTIONS)
end

