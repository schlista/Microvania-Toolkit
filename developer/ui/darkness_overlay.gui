script: "/developer/ui/darkness_overlay.gui_script"
material: "/builtins/materials/gui.material"
adjust_reference: ADJUST_REFERENCE_PARENT
max_nodes: 512

textures {
  name: "gameplay_visuals"
  texture: "/developer/assets/atlas/gameplay_visuals.atlas"
}

nodes {
  position { x: 0.0 y: 0.0 z: 0.0 }
  type: TYPE_BOX
  size { x: 1920.0 y: 1080.0 z: 0.0 }
  adjust_mode: ADJUST_MODE_FIT
  color { x: 1.0 y: 1.0 z: 1.0 w: 1.0 }
  blend_mode: BLEND_MODE_MULT
  pivot: PIVOT_SW
  id: "overlay"
}
adjust_reference: ADJUST_REFERENCE_PARENT
