-- developer/ui/menus/rebind.gui_script
-- Keybinding menu to rebind high-level actions.

local Bindings = require "mvtk.core.input_bindings"
local InputCtl = require "mvtk.rooms.input_controller"

local KNOWN = {
  "gamepad_lpad_left","gamepad_lpad_right","gamepad_lpad_up","gamepad_lpad_down",
  "gamepad_rpad_left","gamepad_rpad_right","gamepad_rpad_up","gamepad_rpad_down",
  "gamepad_lshoulder","gamepad_rshoulder","gamepad_ltrigger","gamepad_rtrigger",
  "gamepad_lstick_click","gamepad_rstick_click","gamepad_guide",
  "gamepad_start","gamepad_back",
}
local H2S = {}
for _, s in ipairs(KNOWN) do H2S[hash(s)] = s end

local ACTIONS = {
  { id = "JUMP",           label = "Jump" },
  { id = "SLIDE",          label = "Slide / Air Dash" },
  { id = "PARRY",          label = "Parry" },
  { id = "GRAPPLE",        label = "Grapple" },
  { id = "LIGHT_MELEE",    label = "Light Melee" },
  { id = "HEAVY_MELEE",    label = "Heavy Melee" },
  { id = "RANGED",         label = "Ranged" },
  { id = "INTERACT",       label = "Interact" },
  { id = "POTION",         label = "Health Potion" },
  { id = "MAP_MARKER",     label = "Map Marker Screenshot" },
  { id = "MINIMAP_TOGGLE", label = "Toggle Minimap" },
  { id = "WORLD_MAP_TOGGLE", label = "Toggle World Map" },
  { id = "PAUSE_TOGGLE",   label = "Pause" },
  { id = "SETTINGS_TOGGLE",label = "Menu" },
}

local v3 = vmath.vector3
local COLOR_SELECTED = vmath.vector4(1, 1, 1, 1)
local COLOR_NORMAL   = vmath.vector4(0.88, 0.88, 0.90, 1)

function init(self)
  msg.post(".", "acquire_input_focus")
  self._enabled = false
  msg.post(".", "disable")

  self.title = gui.get_node("title")
  self.hint = gui.get_node("hint")
  self.capture_text = gui.get_node("capture_text")
  self.root = gui.get_node("root")
  self.row_label_tpl = gui.get_node("row_label")
  self.row_val_tpl = gui.get_node("row_val")

  self.rows = {}
  self.sel = 1
  self.capturing = false

  local root_size = gui.get_size(self.root)
  local row_y = root_size.y / 2 - 80
  for i, act in ipairs(ACTIONS) do
    local label = gui.clone(self.row_label_tpl)
    gui.set_enabled(label, true)
    gui.set_text(label, act.label)
    gui.set_position(label, v3(-root_size.x / 2 + 40, row_y - (i - 1) * 36, 0))
    gui.set_pivot(label, gui.PIVOT_W)

    local binds_text = table.concat(Bindings.get(act.id) or {}, ", ")
    local b = gui.clone(self.row_val_tpl)
    gui.set_enabled(b, true)
    gui.set_text(b, binds_text)
    gui.set_position(b, v3(root_size.x / 2 - 40, row_y - (i - 1) * 36, 0))
    gui.set_pivot(b, gui.PIVOT_E)

    self.rows[i] = { label = label, binds = b }
  end
end

local function update_rows(self)
  for i, row in ipairs(self.rows) do
    local binds = table.concat(Bindings.get(ACTIONS[i].id) or {}, ", ")
    gui.set_text(row.binds, binds)
    local c = (i == self.sel) and COLOR_SELECTED or COLOR_NORMAL
    gui.set_color(row.label, c)
    gui.set_color(row.binds, c)
  end
end

local function close_menu(self)
  self._enabled = false
  msg.post(".", "disable")
  self.capturing = false
  gui.set_text(self.capture_text, "")
  if InputCtl and InputCtl.set_blocked then InputCtl.set_blocked(false) end
end

local function open_menu(self)
  self._enabled = true
  msg.post(".", "enable")
  self.capturing = false
  gui.set_text(self.capture_text, "")
  update_rows(self)
  if InputCtl and InputCtl.set_blocked then InputCtl.set_blocked(true) end
end

function on_message(self, message_id, message, sender)
  if message_id == hash("toggle_rebind") then
    if self._enabled then close_menu(self) else open_menu(self) end
  end
end

function on_input(self, action_id, action)
  if not self._enabled then return end
  if not action or not action.pressed then return end

  if self.capturing then
    if action_id == hash("gamepad_connected")
        or action_id == hash("gamepad_disconnected") then
      return true
    end
    if action.gamepad ~= nil and not InputCtl.accepts_gamepad(action) then
      return true
    end
    local name = action.gamepad ~= nil and H2S[action_id] or nil
    if name then
      local act = ACTIONS[self.sel].id
      Bindings.set_controller_binding(act, name)
      Bindings.save()
      update_rows(self)
      gui.set_text(self.capture_text, "Bound to: " .. name)
    else
      gui.set_text(self.capture_text, "Unsupported input. Try a gamepad button.")
    end
    self.capturing = false
    return
  end

  if action_id == hash("gamepad_start") or action_id == hash("gamepad_back")
      or action_id == hash("gamepad_rpad_right")
      or action_id == hash("key_escape") or action_id == hash("key_m")
      or action_id == hash("key_p") then
    close_menu(self)
    return
  end

  if action_id == hash("key_down") or action_id == hash("key_s")
      or action_id == hash("gamepad_lpad_down")
      or action_id == hash("gamepad_lstick_down") then
    self.sel = math.min(#ACTIONS, self.sel + 1)
    update_rows(self)
  elseif action_id == hash("key_up") or action_id == hash("key_w")
      or action_id == hash("gamepad_lpad_up")
      or action_id == hash("gamepad_lstick_up") then
    self.sel = math.max(1, self.sel - 1)
    update_rows(self)
  elseif action_id == hash("gamepad_rpad_down") or action_id == hash("key_enter") then
    self.capturing = true
    gui.set_text(self.capture_text, "Press a button to bind...")
  end
end
