extrude_borders: 0
inner_padding: 0
max_page_width: 0
max_page_height: 0

# Boss Sprite Animations
# Uses starter boss frames under /developer/assets/atlas/boss
# Replace with your own sprite sheets while keeping animation names

# === IDLE & MOVEMENT ===
animations {
  id: "idle"
  images { image: "/developer/assets/atlas/boss/boss_idle_01.png" }
  images { image: "/developer/assets/atlas/boss/boss_idle_02.png" }
  images { image: "/developer/assets/atlas/boss/boss_idle_03.png" }
  images { image: "/developer/assets/atlas/boss/boss_idle_04.png" }
  images { image: "/developer/assets/atlas/boss/boss_idle_05.png" }
  images { image: "/developer/assets/atlas/boss/boss_idle_06.png" }
  playback: PLAYBACK_LOOP_FORWARD
  fps: 6
  flip_horizontal: 0
  flip_vertical: 0
}

