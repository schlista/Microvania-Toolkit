extrude_borders: 0
inner_padding: 0
max_page_width: 0
max_page_height: 0

animations {
  id: "idle"
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_1_04.png" }
  playback: PLAYBACK_NONE
  fps: 1
  flip_horizontal: 0
  flip_vertical: 0
}

animations {
  id: "move"
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_01.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_02.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_03.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_02.png" }
  playback: PLAYBACK_LOOP_FORWARD
  fps: 12
  flip_horizontal: 0
  flip_vertical: 0
}

animations {
  id: "attack_1"
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_1_01.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_1_02.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_1_03.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_1_04.png" }
  playback: PLAYBACK_ONCE_FORWARD
  fps: 8
  flip_horizontal: 0
  flip_vertical: 0
}

animations {
  id: "attack_2"
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_2_01.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_2_02.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_2_03.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_2_04.png" }
  playback: PLAYBACK_ONCE_FORWARD
  fps: 8
  flip_horizontal: 0
  flip_vertical: 0
}

animations {
  id: "attack_3"
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_01.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_02.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_03.png" }
  images { image: "/developer/assets/atlas/cactus_boss/cactus_attack_3_04.png" }
  playback: PLAYBACK_ONCE_FORWARD
  # Four frames over ~0.57s keeps the run/skid clip aligned with the
  # 900px charge instead of dropping back to idle mid-rush.
  fps: 7
  flip_horizontal: 0
  flip_vertical: 0
}

margin: 0
