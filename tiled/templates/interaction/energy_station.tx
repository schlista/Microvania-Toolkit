<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Energy Station" type="energy_station" width="32" height="32">
  <properties>
   <property name="resource_type" propertytype="resources" value="energy"/>
   <property name="station_id" type="string" value=""/>
   <property name="prompt_text" type="string" value="Restore Energy"/>
   <property name="restoration" type="class" propertytype="energy_station_restoration">
    <properties>
     <property name="restore_amount" type="int" value="0"/>
     <property name="restore_percent" type="float" value="0"/>
    </properties>
   </property>
   <property name="availability" type="class" propertytype="energy_station_availability">
    <properties>
     <property name="uses" type="int" value="-1"/>
     <property name="cooldown" type="float" value="0"/>
     <property name="cost" type="int" value="0"/>
    </properties>
   </property>
   <property name="interaction" type="class" propertytype="energy_station_interaction">
    <properties>
     <property name="require_interact" type="bool" value="true"/>
     <property name="range" type="float" value="96"/>
    </properties>
   </property>
   <property name="feedback" type="class" propertytype="energy_station_feedback">
    <properties>
     <property name="sound_id" propertytype="sound_effects" value="none"/>
    </properties>
   </property>
   <property name="art_item" type="string" value=""/>
   <property name="art_feedback" type="class" propertytype="energy_station_art_feedback">
    <properties>
     <property name="consume_effect" type="string" propertytype="particle_effects" value="none"/>
     <property name="interact_effect" type="string" propertytype="particle_effects" value="none"/>
     <property name="effect_offset_x" type="float" value="0"/>
     <property name="effect_offset_y" type="float" value="0"/>
     <property name="effect_scale" type="float" value="1"/>
     <property name="effect_cooldown" type="float" value="0"/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.7.0"/>
  </properties>
 </object>
</template>
