<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Collectible" type="collectible" width="32" height="32">
  <properties>
   <property name="collectible_id" type="string" value=""/>
   <property name="collectible_type" propertytype="collectibles" value="currency"/>
   <property name="amount" type="int" value="1"/>
   <property name="persistence" type="class" propertytype="collectible_persistence">
    <properties>
     <property name="set_flag_on_collect" type="string" value=""/>
     <property name="respawns" type="bool" value="false"/>
    </properties>
   </property>
   <property name="art_item" type="string" value=""/>
   <property name="art_feedback" type="class" propertytype="collectible_art_feedback">
    <properties>
     <property name="consume_effect" type="string" propertytype="particle_effects" value="none"/>
     <property name="interact_effect" type="string" propertytype="particle_effects" value="none"/>
     <property name="effect_offset_x" type="float" value="0"/>
     <property name="effect_offset_y" type="float" value="0"/>
     <property name="effect_scale" type="float" value="1"/>
     <property name="effect_cooldown" type="float" value="0"/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.7.0"/>
  </properties>
 </object>
</template>
