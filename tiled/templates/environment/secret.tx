<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Secret Area" type="secret" width="256" height="256">
  <properties>
   <property name="secret_type" propertytype="secret_types" value="illusory_wall"/>
   <property name="secret_id" value=""/>
   <property name="discovery" type="class" propertytype="secret_discovery">
    <properties>
     <property name="reveals_on" propertytype="reveal_triggers" value="attack"/>
     <property name="required_ability" propertytype="optional_abilities" value="none"/>
    </properties>
   </property>
   <property name="concealment" type="class" propertytype="secret_concealment">
    <properties>
     <property name="hide_tiles" type="bool" value="true"/>
     <property name="map_reveal" type="bool" value="true"/>
    </properties>
   </property>
   <property name="reward" type="class" propertytype="secret_reward">
    <properties>
     <property name="reward_type" propertytype="collectibles" value="none"/>
     <property name="reward_amount" type="int" value="0"/>
    </properties>
   </property>
   <property name="feedback" type="class" propertytype="secret_feedback">
    <properties>
     <property name="notification" type="bool" value="true"/>
     <property name="notification_text" value="Secret Found!"/>
    </properties>
   </property>
   <property name="art_item" type="string" value=""/>
   <property name="art_feedback" type="class" propertytype="secret_art_feedback">
    <properties>
     <property name="consume_effect" type="string" propertytype="particle_effects" value="none"/>
     <property name="interact_effect" type="string" propertytype="particle_effects" value="none"/>
     <property name="effect_offset_x" type="float" value="0"/>
     <property name="effect_offset_y" type="float" value="0"/>
     <property name="effect_scale" type="float" value="1"/>
     <property name="effect_cooldown" type="float" value="0"/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.7.0"/>
  </properties>
 </object>
</template>
