<?xml version="1.0" encoding="UTF-8"?>
<template>
 <object name="Wall Jump Surface" type="wall_jump_surface" width="32" height="128">
  <properties>
   <property name="surface_type" propertytype="surface_types" value="stone"/>
   <property name="surface_id" type="string" value=""/>
   <property name="abilities" type="class" propertytype="wall_jump_surface_abilities">
    <properties>
     <property name="allow_slide" type="bool" value="true"/>
     <property name="allow_jump" type="bool" value="true"/>
     <property name="allow_climb" type="bool" value="false"/>
     <property name="require_ability" propertytype="optional_abilities" value="wall_jump"/>
    </properties>
   </property>
   <property name="movement" type="class" propertytype="wall_jump_surface_movement">
    <properties>
     <property name="slide_speed" type="float" value="0.3"/>
     <property name="jump_force_x" type="float" value="400.0"/>
     <property name="jump_force_y" type="float" value="500.0"/>
     <property name="facing" type="int" value="1"/>
    </properties>
   </property>
   <property name="mvtk_template_version" type="string" value="2.7.0"/>
  </properties>
 </object>
</template>
