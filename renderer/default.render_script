local Letterbox = require "mvtk.render.letterbox"
local Logger = require "mvtk.core.logger"
Logger.configure_from_debug_config()
local Log = Logger.get_logger("gameplay.camera")

--
-- message constants
--
local MSG_CLEAR_COLOR =         hash("clear_color")
local MSG_WINDOW_RESIZED =      hash("window_resized")
local MSG_SET_VIEW_PROJ =       hash("set_view_projection")
local CAMERA_ID_MVTK =         hash("mvtk_camera_projection")
local MSG_RELEASE_CAMERA_PROJ = hash("release_camera_projection")
local MSG_SET_CAMERA_PROJ =     hash("use_camera_projection")
local MSG_USE_STRETCH_PROJ =    hash("use_stretch_projection")
local MSG_USE_FIXED_PROJ =      hash("use_fixed_projection")
local MSG_USE_FIXED_FIT_PROJ =  hash("use_fixed_fit_projection")
local MSG_USE_AUTO_ZOOM_PROJ =  hash("use_auto_zoom_projection")
-- Debug-shape draw messages from mvtk/debug/debug_draw.lua. Boxes & circles
-- are rasterized into segments and forwarded as engine `draw_line` messages,
-- which `render.draw_debug3d()` already renders each frame.
local MSG_DRAW_DEBUG_BOX    =   hash("draw_debug_box")
local MSG_DRAW_DEBUG_CIRCLE =   hash("draw_debug_circle")
local MSG_DRAW_DEBUG_LINE   =   hash("draw_debug_line")

local DEFAULT_NEAR = -1
local DEFAULT_FAR =   1
local DEFAULT_ZOOM =  1

--
-- projection that centers content with maintained aspect ratio and optional zoom
--
local function get_fixed_projection(camera, state)
    camera.zoom = camera.zoom or DEFAULT_ZOOM
    local projected_width = state.width / camera.zoom
    local projected_height = state.height / camera.zoom
    local left = -(projected_width - state.width) / 2
    local bottom = -(projected_height - state.height) / 2
    local right = left + projected_width
    local top = bottom + projected_height
    return vmath.matrix4_orthographic(left, right, bottom, top, camera.near, camera.far)
end
--
-- projection that centers and fits content with maintained aspect ratio
--
local function get_fixed_fit_projection(camera, state)
    camera.zoom = DEFAULT_ZOOM
    return get_fixed_projection(camera, state)
end
--
-- The viewport performs the fit. Legacy auto-zoom messages retain their authored
-- zoom multiplier without a second fit based on physical window dimensions.
-- camera.get_orthographic_auto_zoom takes a camera id, never four dimensions.
--
local function get_auto_zoom_projection(camera_state, state)
    camera_state.zoom = camera_state.auto_zoom_scale or DEFAULT_ZOOM
    return get_fixed_projection(camera_state, state)
end
--
-- projection that stretches content
--
local function get_stretch_projection(camera, state)
    return vmath.matrix4_orthographic(0, state.width, 0, state.height, camera.near, camera.far)
end
--
-- projection for gui
--
local function get_gui_projection(camera, state)
    return vmath.matrix4_orthographic(0, state.window_width, 0, state.window_height, camera.near, camera.far)
end

local function update_clear_color(state, color)
    if color then
        state.clear_buffers[graphics.BUFFER_TYPE_COLOR0_BIT] = color
    end
end

local function update_camera(camera, state)
    -- If we have a manually set projection (from set_view_projection message), use it
    if camera.manual_projection then
        camera.proj = camera.manual_projection
        camera.options.frustum = camera.proj * camera.view
        camera.options.use_frustum = true
    elseif camera.projection_fn then
        camera.proj = camera.projection_fn(camera, state)
        camera.options.frustum = camera.proj * camera.view
        camera.options.use_frustum = true
    end
end

local function update_state(state)
    state.window_width = render.get_window_width()
    state.window_height = render.get_window_height()
    local width, height = render.get_width(), render.get_height()
    if state.window_width == state.prev_window_width and state.window_height == state.prev_window_height
        and width == state.width and height == state.height then return state.valid end
    state.prev_window_width, state.prev_window_height = state.window_width, state.window_height
    state.width, state.height = width, height
    state.rect = Letterbox.rect(state.window_width, state.window_height, width, height)
    state.valid = state.rect ~= nil
    if not state.valid then
        Log.debug("letterbox render inactive window=%s,%s", tostring(state.window_width), tostring(state.window_height))
        return false
    end
    local rect = state.rect
    Log.debug("letterbox render window=%dx%d design=%dx%d rect=%d,%d,%d,%d scale=%.9f",
        state.window_width, state.window_height, width, height, rect.x, rect.y, rect.w, rect.h, rect.scale)
    for _, camera in pairs(state.cameras) do update_camera(camera, state) end
    return true
end

local function init_camera(camera, projection_fn, near, far, zoom)
    -- Explicit projection-mode changes release the custom camera's ownership.
    camera.manual_projection = nil
    camera.projection_owner = nil
    camera.view = vmath.matrix4()
    camera.near = near == nil and DEFAULT_NEAR or near
    camera.far = far == nil and DEFAULT_FAR or far
    camera.zoom = zoom == nil and DEFAULT_ZOOM or zoom
    camera.auto_zoom_scale = DEFAULT_ZOOM
    camera.projection_fn = projection_fn
end

local function set_premultiplied_alpha_blend()
    if type(render.set_blend_func_separate) == "function" then
        render.set_blend_func_separate(
            graphics.BLEND_FACTOR_ONE,
            graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
            graphics.BLEND_FACTOR_ONE,
            graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        )
    else
        render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    end
end

local function set_additive_glow_blend()
    if type(render.set_blend_func_separate) == "function" then
        render.set_blend_func_separate(
            graphics.BLEND_FACTOR_SRC_ALPHA,
            graphics.BLEND_FACTOR_ONE,
            graphics.BLEND_FACTOR_ONE,
            graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        )
    else
        render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE)
    end
end

local function create_predicates(...)
    local arg = {...}
    local predicates = {}
    for _, predicate_name in pairs(arg) do
        predicates[predicate_name] = render.predicate({predicate_name})
    end
    return predicates
end

local function create_camera(state, name, is_main_camera)
    local camera = {}
    camera.options = {}
    state.cameras[name] = camera
    if is_main_camera then
        state.main_camera = camera
    end
    return camera
end

local function create_state()
    local state = {}
    local color = vmath.vector4(0, 0, 0, 0)
    color.x = sys.get_config_number("render.clear_color_red", 0)
    color.y = sys.get_config_number("render.clear_color_green", 0)
    color.z = sys.get_config_number("render.clear_color_blue", 0)
    color.w = sys.get_config_number("render.clear_color_alpha", 0)
    state.clear_buffers = {
        [graphics.BUFFER_TYPE_COLOR0_BIT] = color,
        [graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
        [graphics.BUFFER_TYPE_STENCIL_BIT] = 0
    }
    state.cameras = {}
    return state
end

local function set_camera_world(state)
    local camera_world = state.cameras.camera_world
    if camera_world.projection_owner == CAMERA_ID_MVTK and camera_world.manual_projection then
        render.set_view(camera_world.view)
        render.set_projection(camera_world.proj)
        return camera_world.options
    end

    -- Camera components calculate their projection from the real window. Keep
    -- their authored view/clip planes/zoom, but fit the design area ourselves.
    -- Binding render.set_camera would override these explicit matrices.
    local components = camera.get_cameras()
    for i = #components, 1, -1 do
        local id = components[i]
        if camera.get_enabled(id) then
            local component = state.cameras.camera_component
            local original = camera.get_projection(id)
            local near, far = camera.get_near_z(id), camera.get_far_z(id)
            component.view = camera.get_view(id)
            if original.m33 == 0 then
                component.proj = vmath.matrix4_perspective(camera.get_fov(id), state.width / state.height, near, far)
            else
                local zoom = camera.get_orthographic_zoom(id)
                local hw, hh = state.width / zoom / 2, state.height / zoom / 2
                component.proj = vmath.matrix4_orthographic(-hw, hw, -hh, hh, near, far)
            end
            component.options.frustum = component.proj * component.view
            component.options.use_frustum = true
            render.set_view(component.view)
            render.set_projection(component.proj)
            return component.options
        end
    end

    -- Standalone legacy projection messages remain supported when there is no
    -- active component. MVTK-owned projections always take precedence above.
    render.set_view(camera_world.view)
    render.set_projection(camera_world.proj)
    return camera_world.options
end

-- Debug shape queue. Populated by `draw_debug_box` / `draw_debug_circle` /
-- `draw_debug_line` messages from mvtk/debug/debug_draw.lua. Drained and
-- cleared each frame so visualizations never linger past the frame they
-- were posted for.
local DEBUG_CIRCLE_SEGMENTS = 24

local function rasterize_box(out, position, size, color)
    local hw = (size.x or 0) * 0.5
    local hh = (size.y or 0) * 0.5
    local x = position.x or 0
    local y = position.y or 0
    local z = position.z or 0
    local tl = vmath.vector3(x - hw, y + hh, z)
    local tr = vmath.vector3(x + hw, y + hh, z)
    local br = vmath.vector3(x + hw, y - hh, z)
    local bl = vmath.vector3(x - hw, y - hh, z)
    out[#out+1] = { s = tl, e = tr, c = color }
    out[#out+1] = { s = tr, e = br, c = color }
    out[#out+1] = { s = br, e = bl, c = color }
    out[#out+1] = { s = bl, e = tl, c = color }
end

local function rasterize_circle(out, position, radius, color)
    local cx = position.x or 0
    local cy = position.y or 0
    local cz = position.z or 0
    local r = radius or 0
    local prev_x = cx + r
    local prev_y = cy
    for i = 1, DEBUG_CIRCLE_SEGMENTS do
        local theta = (i / DEBUG_CIRCLE_SEGMENTS) * math.pi * 2
        local x = cx + math.cos(theta) * r
        local y = cy + math.sin(theta) * r
        out[#out+1] = {
            s = vmath.vector3(prev_x, prev_y, cz),
            e = vmath.vector3(x, y, cz),
            c = color,
        }
        prev_x = x
        prev_y = y
    end
end

function init(self)
    self.predicates = create_predicates("tile", "sprite", "glow", "gui", "particle", "particlefx", "model", "debug_text")

    -- All projections render inside the fitted design viewport. Legacy messages
    -- or send a message to the render script to change projection:
    -- msg.post("@render:", "use_stretch_projection", { near = -1, far = 1 })
    -- msg.post("@render:", "use_fixed_projection", { near = -1, far = 1, zoom = 2 })
    -- msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })
    -- msg.post("@render:", "use_auto_zoom_projection", { near = -1, far = 1, zoom = 1 })

    local state = create_state()
    self.state = state

    local camera_world = create_camera(state, "camera_world", true)
    init_camera(camera_world, get_stretch_projection)
    local camera_gui = create_camera(state, "camera_gui")
    init_camera(camera_gui, get_gui_projection)
    -- Create a special camera that wraps camera components (if they exist)
    -- Component cameras are fitted to the design; an MVTK owner takes precedence.
    local camera_component = create_camera(state, "camera_component")
    update_state(state)
end

function update(self)
    local state = self.state
    if not update_state(state) then return end

    local predicates = self.predicates
    -- clear screen buffers
    --
    -- turn on depth_mask before `render.clear()` to clear it as well
    render.set_depth_mask(true)
    render.set_stencil_mask(0xff)
    render.clear(state.clear_buffers)

    -- setup camera view and projection
    --
    local draw_options_world = set_camera_world(state)
    render.set_viewport(state.rect.x, state.rect.y, state.rect.w, state.rect.h)

    -- set states used for all the world predicates
    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.enable_state(graphics.STATE_DEPTH_TEST)

    -- render `model` predicate for default 3D material
    --
    render.enable_state(graphics.STATE_CULL_FACE)
    render.draw(predicates.model, draw_options_world)
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_CULL_FACE)

    -- render the other components: sprites, tilemaps, particles etc
    -- 2D pass: no depth test, premultiplied alpha blending
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.enable_state(graphics.STATE_BLEND)
    set_premultiplied_alpha_blend()
    render.draw(predicates.tile, draw_options_world)
    render.draw(predicates.sprite, draw_options_world)
    render.draw(predicates.particle, draw_options_world)
    render.draw(predicates.particlefx, draw_options_world)
    set_additive_glow_blend()
    render.draw(predicates.glow, draw_options_world)
    set_premultiplied_alpha_blend()

    render.draw_debug3d()

    -- render GUI
    --
    local camera_gui = state.cameras.camera_gui
    render.set_viewport(0, 0, state.window_width, state.window_height)
    render.set_view(camera_gui.view)
    render.set_projection(camera_gui.proj)

    render.enable_state(graphics.STATE_STENCIL_TEST)
    render.draw(predicates.gui, camera_gui.options)
    render.draw(predicates.debug_text, camera_gui.options)
    render.disable_state(graphics.STATE_STENCIL_TEST)
    render.disable_state(graphics.STATE_BLEND)
end

function on_message(self, message_id, message)
    local state = self.state
    local camera = state.main_camera

    if message_id == MSG_DRAW_DEBUG_BOX then
        local pos = message.position or vmath.vector3()
        local sz = message.size or vmath.vector3()
        local color = message.color or vmath.vector4(1, 0, 0, 1)
        local segs = {}
        rasterize_box(segs, pos, sz, color)
        for _, seg in ipairs(segs) do
            msg.post("@render:", "draw_line", { start_point = seg.s, end_point = seg.e, color = seg.c })
        end
        return
    elseif message_id == MSG_DRAW_DEBUG_CIRCLE then
        local pos = message.position or vmath.vector3()
        local color = message.color or vmath.vector4(1, 0, 0, 1)
        local segs = {}
        rasterize_circle(segs, pos, message.radius or 0, color)
        for _, seg in ipairs(segs) do
            msg.post("@render:", "draw_line", { start_point = seg.s, end_point = seg.e, color = seg.c })
        end
        return
    elseif message_id == MSG_DRAW_DEBUG_LINE then
        msg.post("@render:", "draw_line", {
            start_point = message.start_pos or vmath.vector3(),
            end_point = message.end_pos or vmath.vector3(),
            color = message.color or vmath.vector4(1, 1, 0, 1),
        })
        return
    elseif message_id == MSG_CLEAR_COLOR then
        update_clear_color(state, message.color)
    elseif message_id == MSG_WINDOW_RESIZED then
        update_state(state)
    elseif message_id == MSG_SET_VIEW_PROJ then
        -- A focused camera component posts after game-script late_update.
        -- Once MVTK supplies its committed view, do not replace it with that
        -- component's projection (which can use different window dimensions).
        -- Component-only projects retain their existing message behavior.
        if message.id == CAMERA_ID_MVTK then
            camera.projection_owner = CAMERA_ID_MVTK
        elseif camera.projection_owner == CAMERA_ID_MVTK then
            return
        end
        camera.view = message.view
        -- Store the projection directly so it won't be overwritten by projection_fn
        camera.manual_projection = message.projection
        self.camera_projection = message.projection or vmath.matrix4()
        update_camera(camera, state)
    elseif message_id == MSG_RELEASE_CAMERA_PROJ then
        -- Only the current explicit owner may release this projection.
        if message.id == CAMERA_ID_MVTK and camera.projection_owner == message.id then
            camera.manual_projection = nil
            camera.projection_owner = nil
            update_camera(camera, state)
        end
    elseif message_id == MSG_SET_CAMERA_PROJ then
        camera.manual_projection = nil
        camera.projection_owner = nil
        camera.projection_fn = function() return self.camera_projection end
    elseif message_id == MSG_USE_STRETCH_PROJ then
        init_camera(camera, get_stretch_projection, message.near, message.far)
        update_camera(camera, state)
    elseif message_id == MSG_USE_FIXED_PROJ then
        init_camera(camera, get_fixed_projection, message.near, message.far, message.zoom)
        update_camera(camera, state)
    elseif message_id == MSG_USE_FIXED_FIT_PROJ then
        init_camera(camera, get_fixed_fit_projection, message.near, message.far)
        update_camera(camera, state)
    elseif message_id == MSG_USE_AUTO_ZOOM_PROJ then
        init_camera(camera, get_auto_zoom_projection, message.near, message.far, message.zoom)
        camera.auto_zoom_scale = message.zoom or DEFAULT_ZOOM
        update_camera(camera, state)
    end
end
