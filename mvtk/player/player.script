-- Lightweight SFX helper
local function play_sfx(id, opts)
  if not id then return end
  if _Audio and _Audio.sfx then
    pcall(_Audio.sfx, id, opts)
  end
end

local function ability_unlocked(id)
  if not id then return true end
  if AbilityManager and AbilityManager.get_ability_info then
    local ok, info = pcall(AbilityManager.get_ability_info, id)
    if ok and info then
      return info.unlocked and (info.enabled ~= false)
    end
  end
  if AbilityManager and AbilityManager.is_ability_unlocked then
    local ok, unlocked = pcall(AbilityManager.is_ability_unlocked, id)
    if ok then return unlocked and true or false end
  end
  return true
end

local function ability_unlocked_strict(id)
  if not id then return false end
  if AbilityManager and AbilityManager.get_ability_info then
    local ok, info = pcall(AbilityManager.get_ability_info, id)
    if ok and info then
      return info.unlocked and (info.enabled ~= false)
    end
  end
  if AbilityManager and AbilityManager.is_ability_unlocked then
    local ok, unlocked = pcall(AbilityManager.is_ability_unlocked, id)
    if ok then return unlocked and true or false end
  end
  return false
end

-- Missing swim definitions are authoring/configuration errors, not an intended
-- progression lock. Warn once and leave water traversable so a trimmed ability
-- registry cannot turn every water volume into an unexplained death pit.
local _warned_missing_swim = false

-- Seconds between in-water re-checks of the swim gate.
local SWIM_GATE_RECHECK_INTERVAL = 0.25

-- An unlock can live in three places and they can legitimately disagree.
-- `AbilityManager` holds the live registry, but `Checkpoint`'s provider calls
-- `AbilityManager.reset()` whenever a restore carries no `abilities` payload
-- (a save written before the pickup, a legacy slot, a defaults restore). That
-- wipes the runtime unlock while `ProgressionManager.unlocked_abilities` and
-- the `Flags` mirror still hold it -- so a player who really did collect Swim
-- gets gated, sinks and drowns, and the respawn repeats the whole cycle.
-- Ask every store, and repair the registry when a survivor is found. This
-- mirrors `is_ability_unlocked` in mvtk/collectibles/collectible.script, which
-- has always consulted both Progression and AbilityManager.
local function ability_unlocked_any_store(id)
  local defined = false

  if AbilityManager and AbilityManager.get_ability_info then
    local ok, info = pcall(AbilityManager.get_ability_info, id)
    if ok and type(info) == "table" then
      defined = true
      if info.unlocked and info.enabled ~= false then return true, "ability_manager", defined end
    end
  end
  if AbilityManager and AbilityManager.is_ability_unlocked then
    local ok, unlocked = pcall(AbilityManager.is_ability_unlocked, id)
    if ok and unlocked then return true, "ability_manager", defined end
  end

  if Progression and Progression.is_ability_unlocked then
    local ok, unlocked = pcall(Progression.is_ability_unlocked, id)
    if ok and unlocked then return true, "progression", defined end
  end

  if Flags and Flags.get then
    local ok, flagged = pcall(Flags.get, id)
    if ok and flagged then return true, "flags", defined end
  end

  return false, "locked", defined
end

local function swim_gate_ok()
  local cfg = SWIM_CFG
  if cfg.require_ability == false then return true end

  local id = cfg.ability_id or "swim"
  local unlocked, source, defined = ability_unlocked_any_store(id)

  if unlocked then
    -- Heal the divergence so cooldown/stamina bookkeeping, the HUD and the
    -- next save all agree with the gate we just opened.
    if source ~= "ability_manager" and AbilityManager and AbilityManager.unlock_ability then
      pcall(AbilityManager.unlock_ability, id, { enabled = true })
      print(string.format("[SWIM] '%s' was unlocked in %s but missing from AbilityManager - restored", id, source))
    end
    return true
  end

  if not defined then
    if not _warned_missing_swim then
      _warned_missing_swim = true
      print(string.format("[SWIM] ability '%s' is not defined in developer/config/abilities.lua - treating as unlocked", id))
    end
    return true
  end

  return false
end

--- Consolidated ability activation: checks unlock + cooldown + stamina via AbilityManager.
-- Returns true if the ability was successfully consumed.
local function consume_ability(id)
  if not AbilityManager then return true end
  if AbilityManager.use_ability then
    local ok, used = pcall(AbilityManager.use_ability, id)
    if ok then return used end
  end
  -- Fallback: allow if unlocked (no stamina/cooldown tracking)
  return ability_unlocked(id)
end

--- Check if an ability can be activated (unlock + cooldown + stamina).
local function can_consume_ability(id)
  if not AbilityManager then return ability_unlocked(id) end
  if AbilityManager.can_use_ability then
    local ok, allowed = pcall(AbilityManager.can_use_ability, id)
    if ok then return allowed end
  end
  return ability_unlocked(id)
end

