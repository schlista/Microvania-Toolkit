local PROXIED_DIRECT_DEDUPE = {
  [hash("one_way_contact")] = true,
  [hash("external_force")] = true,
  [hash("apply_external_force")] = true,
  [hash("apply_force")] = true,
  [hash("apply_movement_modifier")] = true,
