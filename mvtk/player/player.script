-- Load InteractionManager lazily to avoid circular-dependency / load-order issues.
local InteractionManager
local function get_interaction_manager()
    if InteractionManager ~= nil then return InteractionManager end
    local ok, mgr = pcall(require, "mvtk.game.interaction_manager")
    InteractionManager = ok and mgr or false
    return InteractionManager
end


local raw_print = print
local function player_log(...)
    if Debug.global.enable or Debug.gameplay.player then
        raw_print(...)
    end
end

local function input_log(...)
    if Debug.global.enable or Debug.gameplay.input then
        raw_print(...)
    end
end

local function sync_player_position(self)
  if not self or not self.pos then
    return
  end
  self.pos.z = PLAYER_RENDER_Z
  go.set_position(self.pos)
end

local function ensure_player_render_z(self)
  if not self then
    return
  end
  local pos = self.pos or go.get_position()
  if not pos then
    return
  end
  self.pos = pos
  if math.abs((self.pos.z or 0) - PLAYER_RENDER_Z) > 0.0001 then
    sync_player_position(self)
  end
end

