local function sorted_string_keys(t)
    local out = {}
    if type(t) ~= "table" then
        return out
    end
    for k, _ in pairs(t) do
        if type(k) == "string" and k ~= "" then
            out[#out + 1] = k
        end
    end
    table.sort(out)
    return out
end

local CUTSCENE_IDS_CACHE = nil

local function cutscene_ids()
    if CUTSCENE_IDS_CACHE ~= nil then
        return CUTSCENE_IDS_CACHE
    end

    local seen = {}
    local ids = {}

    local function add_from_module(module_name)
        local ok, cutscenes = pcall(require, module_name)
        if ok and type(cutscenes) == "table" then
            for _, id in ipairs(sorted_string_keys(cutscenes)) do
                if not seen[id] then
                    seen[id] = true
                    ids[#ids + 1] = id
                end
            end
        end
    end

    add_from_module("developer.config.narrative.cutscenes")
    add_from_module("developer.config.narrative.cutscenes_generated")

    table.sort(ids)
    CUTSCENE_IDS_CACHE = ids
    if #CUTSCENE_IDS_CACHE == 0 then
        CUTSCENE_IDS_CACHE = {}
    end
    return CUTSCENE_IDS_CACHE
end

local function resolve_cutscene_id(value)
    local normalized = normalize_hash_string(value)
    if normalized then
        return normalized
    end
    if type(value) == "userdata" then
        for _, id in ipairs(cutscene_ids()) do
            if value == hash(id) then
                return id
            end
        end
    end
    return nil
end

local function room_matches(player_room, zone_room)
    return (not zone_room) or (zone_room == "") or (not player_room) or (zone_room == player_room)
end

local function post_camera_enter_room(room_id, instant)
    local normalized = normalize_hash_string(room_id)
    if not normalized then
        return
    end

    local camera_url = (C.URL and C.URL.CAMERA) or msg.url("main:/camera#script")
    pcall(msg.post, camera_url, hash("enter_room"), {
        room_id = normalized,
        instant = instant == true,
    })
end

