        print(...)
    end
end

local function spawn_log(...)
    if (Debug.global and Debug.global.enable)
        or (Debug.gameplay and Debug.gameplay.spawner)
    then
        print(...)
    end
end

local normalize_hash_string = Util.normalize_hash_string

local function trim_string(value)
    if value == nil then
        return nil
    end
    local s = Util.trim(value)
    if s == "" then
        return nil
    end
    return s
end

local function split_csv(value)
    local items = {}
    local raw = trim_string(value)
    if not raw then
        return items
    end
    for token in raw:gmatch("[^,]+") do
        local item = trim_string(token)
        if item then
            items[#items + 1] = item
        end
    end
    return items
end

local function coerce_bool(value, default)
    return Util.to_bool(value, default and true or false)
end

