local function reset_boss_fights(self, reason)
    local ok_boss, BossManager = pcall(require, "mvtk.bosses.boss_manager")
    if ok_boss and BossManager and BossManager.reset_active_bosses then
        BossManager.reset_active_bosses(reason)
    end

    if self and self.boss_spawns then
        for id, data in pairs(self.boss_spawns) do
            if data and data.active_boss_url and go.exists(data.active_boss_url) then
                go.delete(data.active_boss_url)
            end
            local defeated = false
            if ok_boss and BossManager and BossManager.is_boss_defeated then
                local check_id = data and (data.boss_preset or data.boss_type or data.boss_id or data.boss_tag or id)
                if check_id then
                    defeated = BossManager.is_boss_defeated(check_id)
                end
            end
            if data then
                data.spawned = defeated and true or false
                data.active_boss_id = nil
                data.active_boss_url = nil
            end
        end
    end

    if self and self.arena_locks then
        for _, lock in pairs(self.arena_locks) do
            lock.triggered = false
            lock.player_inside = false
        end
    end

    pcall(msg.post, "main:/room_manager#script", hash("unlock_all_rooms"), {
        source = reason or "boss_reset",
    })
end

