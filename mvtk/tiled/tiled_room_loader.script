go.property("skip_spawn_enemy", false)
go.property("skip_spawn_collectible", false)
go.property("skip_spawn_chest", false)
go.property("skip_spawn_ability", false)
go.property("skip_spawn_lore_item", false)
go.property("skip_spawn_npc", false)
go.property("skip_spawn_dialogue_trigger", false)
