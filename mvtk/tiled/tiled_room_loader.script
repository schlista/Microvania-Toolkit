--- Tiled Room Loader Script
-- Drop this on a game object in your room collection to automatically:
-- - Load Tiled map data
-- - Setup parallax layers
-- - Spawn objects from object layers
-- - Integrate with camera system
--
-- Required properties:
--   tiled_map_path: Path to exported Tiled .lua file
--   room_id: Unique identifier for this room
--
-- @script tiled_room_loader

local TiledParser = require "mvtk.tiled.tiled_parser"
local ParallaxManager = require "mvtk.tiled.parallax_layer_manager"
local ObjectSpawner = require "mvtk.tiled.object_spawner"
local TilemapAnimator = require "mvtk.tiled.tilemap_animator"
local DialogueRegistry = require "mvtk.dialogue.dialogue_registry"
local C = require "mvtk.core.constants"
local TiledRoomRegistry = require "mvtk.tiled.tiled_room_registry"
local Util = require "mvtk.core.util"
local StreamPaths = require "mvtk.rooms.stream_paths"
local Debug = require "developer.config.debug_config"

-- DEPRECATED: Room paths are now auto-discovered via TiledRoomRegistry
-- The registry scans the configured tiled_maps_dir for exported .lua files
-- No manual registration needed - just export from Tiled and it will be found
local ROOM_MAP_PATHS = nil  -- Will be populated by get_room_map_paths()
local STATIC_DIALOGUES = nil

-- Script properties
go.property("room_id", "")  -- Room identifier (text)
go.property("auto_spawn_objects", true)  -- Automatically spawn objects on init
go.property("auto_setup_parallax", true)  -- Automatically setup parallax layers
go.property("parallax_enabled", true)  -- Enable/disable parallax system
go.property("auto_tile_animations", true)  -- Animate painted tile cells using tilemap_animator
go.property("enable_parallax_clipping", true)  -- Apply parallax_clip material to constrain backgrounds to room bounds
-- Comma-separated Tiled object types to skip when those objects are already baked into the room collection.
-- Format: "enemy,gate,checkpoint". Common types: spawn_point, boss, collectible, ability, enemy, gate,
-- hazard, checkpoint, fast_travel, breakable_wall. See mvtk/tiled/tiled_properties_reference.lua for the full object type reference.
go.property("skip_spawn_types", "")
go.property("skip_spawn_spawn_point", false)
go.property("skip_spawn_boss", false)
go.property("skip_spawn_boss_phase", false)
go.property("skip_spawn_boss_arena", false)
go.property("skip_spawn_arena_lock", false)
