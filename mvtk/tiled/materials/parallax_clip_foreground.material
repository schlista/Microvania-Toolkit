name: "parallax_clip_foreground"
tags: "sprite"
vertex_program: "/mvtk/tiled/materials/parallax_clip.vp"
fragment_program: "/mvtk/tiled/materials/parallax_clip.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "clip_rect"
  type: CONSTANT_TYPE_USER
  value {
    x: -1000000.0
    y: -1000000.0
    z: 1000000.0
    w: 1000000.0
  }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
