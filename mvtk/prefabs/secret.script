-- Secret area script
-- Reveals hidden content when triggered
-- Loads configuration from developer/config/secret_types.lua

go.property("secret_id", "")
go.property("secret_type", "illusory_wall")
go.property("reveals_on", "touch")
go.property("required_ability", "")
go.property("width", 64)
go.property("height", 64)
go.property("hide_tiles", false)
go.property("notification", true)
go.property("notification_text", "")
go.property("reward_type", "")
go.property("reward_amount", 0)
go.property("map_reveal", true)
go.property("room_id", "")

local flags = require "mvtk.core.flags"
local SurfaceClassifier = require "mvtk.core.surface_classifier"
local PU = require "mvtk.prefabs.prefab_utils"
local Util = require "mvtk.core.util"
local TriggerBus = require "mvtk.world.trigger_bus"
local RewardDrops = require "mvtk.collectibles.reward_drops"
local MSG_REVEAL = hash("reveal_secret")
local MSG_DAMAGE = hash("mvtk_apply_damage")
local ATTACK_GROUP = hash("attack")

-- Load secret type configurations
local SecretTypes = nil
local ok_secrets, secret_data = pcall(require, "developer.config.secret_types")
if ok_secrets then SecretTypes = secret_data end

local function resolve_tile_bounds(frame, pos, width, height, TileFrame)
    if not (frame and pos and width and height) then
        return nil
    end
    local function sample(min_x, min_y, max_x, max_y)
        local corners = {
            { min_x, min_y },
            { min_x, max_y },
            { max_x, min_y },
            { max_x, max_y },
        }
        local valid = 0
        local min_tx, max_tx, min_ty, max_ty
        for _, corner in ipairs(corners) do
            local tx, ty = TileFrame.world_to_tiles(frame, corner[1], corner[2])
            if tx then
                valid = valid + 1
                min_tx = min_tx and math.min(min_tx, tx) or tx
                max_tx = max_tx and math.max(max_tx, tx) or tx
                min_ty = min_ty and math.min(min_ty, ty) or ty
                max_ty = max_ty and math.max(max_ty, ty) or ty
            end
        end
        return valid, min_tx, max_tx, min_ty, max_ty
    end

    local half_w = width * 0.5
    local half_h = height * 0.5
    local valid_center, cmin_tx, cmax_tx, cmin_ty, cmax_ty = sample(
        pos.x - half_w, pos.y - half_h, pos.x + half_w, pos.y + half_h
    )
    local valid_top, tmin_tx, tmax_tx, tmin_ty, tmax_ty = sample(
        pos.x, pos.y - height, pos.x + width, pos.y
    )

    local use_center = valid_center >= valid_top
    local min_tx = use_center and cmin_tx or tmin_tx
    local max_tx = use_center and cmax_tx or tmax_tx
    local min_ty = use_center and cmin_ty or tmin_ty
    local max_ty = use_center and cmax_ty or tmax_ty

    if not min_tx or not max_tx or not min_ty or not max_ty then
        return nil
    end

    min_tx = math.max(frame.min_tx, min_tx)
    max_tx = math.min(frame.max_tx, max_tx)
    min_ty = math.max(frame.min_ty, min_ty)
    max_ty = math.min(frame.max_ty, max_ty)

    if min_tx > max_tx or min_ty > max_ty then
        return nil
    end

    return min_tx, max_tx, min_ty, max_ty
end

local function clear_secret_tiles(self)
    if not self.hide_tiles then
        return
    end

    local ok_rm, RoomManager = pcall(require, "mvtk.map.streaming.room_manager")
    if not ok_rm or not RoomManager or not RoomManager.get_tilemap_url then
        return
    end

    local room_id = self.room_id_str or PU.normalize_hash_string(self.room_id)
    if (not room_id or room_id == "") and RoomManager.get_current_room then
        room_id = RoomManager.get_current_room()
    end
    if not room_id or room_id == "" then
        return
    end

    local tm_url, tm_pos = RoomManager.get_tilemap_url(room_id)
    if not tm_url or not tm_pos then
        return
    end

    local ok_tf, TileFrame = pcall(require, "mvtk.rooms.tile_frame")
    if not ok_tf or not TileFrame then
        return
    end

    local frame = TileFrame.build(tm_url, tm_pos)
    if not frame then
        return
    end

    local pos = go.get_position()
    local width = tonumber(self.width) or 0
    local height = tonumber(self.height) or 0
    if width <= 0 or height <= 0 then
        return
    end

    local min_tx, max_tx, min_ty, max_ty = resolve_tile_bounds(frame, pos, width, height, TileFrame)
    if not min_tx then
        return
    end

    local layers = {}
    if self.config and self.config.layer_name then
        local resolved = SurfaceClassifier.resolve_existing_layers(tm_url, {
            self.config.layer_name,
            SurfaceClassifier.GROUPS.SOLID,
            SurfaceClassifier.GROUPS.WALL,
            SurfaceClassifier.GROUPS.GROUND,
        })
        for _, layer_hash in ipairs(resolved) do
            layers[#layers + 1] = layer_hash
        end
    end
    if #layers == 0 then
        layers[#layers + 1] = SurfaceClassifier.resolve_first_existing_layer(tm_url, {
            SurfaceClassifier.GROUPS.SOLID,
            SurfaceClassifier.GROUPS.WALL,
            SurfaceClassifier.GROUPS.GROUND,
        }, SurfaceClassifier.GROUPS.SOLID)
    end

    for _, layer_hash in ipairs(layers) do
        local ok_bounds = pcall(tilemap.get_bounds, tm_url, layer_hash)
        if ok_bounds then
            for ty = min_ty, max_ty do
                for tx = min_tx, max_tx do
                    pcall(tilemap.set_tile, tm_url, layer_hash, tx, ty, 0)
                end
            end
        end
    end
end

function init(self)
    self.revealed = false
    self.config = nil
    self.room_id_str = PU.normalize_hash_string(self.room_id)
    self.notification_text_str = PU.normalize_hash_string(self.notification_text) or "Secret Found!"
    self.reward_type_str = PU.normalize_hash_string(self.reward_type)
    
    -- Load config for this secret type
    local type_str = nil
    for key, _ in pairs(SecretTypes or {}) do
        if key == self.secret_type then
            type_str = key
            break
        end
    end
    if type_str and SecretTypes[type_str] then
        self.config = SecretTypes[type_str]
        -- Apply config defaults if not set via Tiled
        if self.reveals_on == "touch" and self.config.reveal_method then
            self.reveals_on = self.config.reveal_method
        end
        if self.required_ability == "" and self.config.required_ability then
            self.required_ability = self.config.required_ability
        end
    end
    
    -- A breakable wall with reveals_secret = <secret_id> reveals this secret
    -- through TriggerBus when it breaks.
    TriggerBus.register(self.secret_id, msg.url())

    -- Check if already revealed via persistence
    local flag_id = "secret_" .. tostring(self.secret_id)
    if flags.get(flag_id) then
        self.revealed = true
        require("mvtk.tiled.object_presentation").restore(nil, true)
        -- Already revealed - hide the secret blocker
        Util.set_component_enabled("#sprite", false)
        Util.post_component_enabled("#collisionobject", false)
        Util.set_component_enabled("#attack_trigger", false, "mass")
        clear_secret_tiles(self)
    end
end

function final(self)
    TriggerBus.unregister(self.secret_id, msg.url())
end

local function reveal_secret(self)
    if self.revealed then return end
    
    self.revealed = true
    require("mvtk.tiled.object_presentation").emit("collected", nil, true)
    
    -- Persist the reveal
    local flag_id = "secret_" .. tostring(self.secret_id)
    flags.set(flag_id, true)
    
    -- Play reveal effect
    msg.post("main:/fx_manager#fx_manager", hash("spawn_effect"), {
        effect_type = "secret_reveal",
        position = go.get_position()
    })
    
    -- Hide the secret blocker
    if Util.component_exists("#sprite") then
        go.animate("#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 0.3, 0, function()
            Util.set_component_enabled("#sprite", false)
        end)
    end
    Util.post_component_enabled("#collisionobject", false)
    Util.set_component_enabled("#attack_trigger", false, "mass")

    clear_secret_tiles(self)

    -- Spawn the reward as real pickups (spawn_collectible alone only records
    -- data, so the reward never appeared). Currency: one pickup worth
    -- reward_amount; other types: reward_amount pickups.
    if self.reward_type_str and self.reward_type_str ~= "" and (tonumber(self.reward_amount) or 0) > 0 then
        local types = Util.require_config("developer.config.collectible_types") or {}
        local drops = RewardDrops.plan({ { type = self.reward_type_str, amount = tonumber(self.reward_amount) } },
            types, "secret_" .. tostring(PU.normalize_hash_string(self.secret_id) or "secret") .. "_reward_")
        RewardDrops.spawn(drops, go.get_position())
    end
    
    -- Notify minimap
    msg.post("main:/minimap_gui#minimap", hash("secret_revealed"), {
        secret_id = self.secret_id,
        room_id = self.room_id
    })

    if self.map_reveal ~= false then
        local ok_secret, SecretDetector = pcall(require, "mvtk.collectibles.secret_detector")
        if ok_secret and SecretDetector and SecretDetector.reveal_on_minimap then
            SecretDetector.reveal_on_minimap(self.room_id_str, go.get_position())
        end
    end
    
    -- Show toast (the toast GUI listens for "toast"; "show_toast" was ignored).
    if self.notification ~= false then
        PU.toast(self.notification_text_str or "Secret Found!", 3.0)
    end
    
    print(string.format("[SECRET] Revealed secret '%s'", tostring(self.secret_id)))
end

function on_message(self, message_id, message, sender)
    if self.revealed then return end
    
    if message_id == hash("trigger_response") then
        local other_group = message.other_group or message.group
        if message.enter and other_group == ATTACK_GROUP then
            -- A melee hitbox overlapped #attack_trigger.
            if self.reveals_on == "attack" then
                reveal_secret(self)
            end
            return
        end
        if message.enter and self.reveals_on == "touch" then
            -- Check ability requirement
            if self.required_ability ~= "" then
                local abilities = require "mvtk.abilities.ability_manager"
                if not abilities.has_ability(self.required_ability) then
                    return
                end
            end
            reveal_secret(self)
        end
    elseif message_id == MSG_REVEAL then
        -- Linked breakable wall broke (or a script asked): always reveal.
        reveal_secret(self)
    elseif message_id == hash("attack_hit") or message_id == MSG_DAMAGE then
        -- Player melee hits the #attack_trigger (group "breakable") and sends
        -- mvtk_apply_damage; attack_hit is kept for older senders.
        if self.reveals_on == "attack" then
            reveal_secret(self)
        end
    elseif message_id == hash("ability_used") then
        if self.reveals_on == "ability" then
            if self.required_ability == "" or message.ability == self.required_ability then
                reveal_secret(self)
            end
        end
    elseif message_id == hash("interact") then
        if self.reveals_on == "interact" then
            reveal_secret(self)
        end
    end
end
