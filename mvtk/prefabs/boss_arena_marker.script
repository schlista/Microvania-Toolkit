local Proxy = require "mvtk.prefabs.tiled_proxy_util"
local Util = require "mvtk.core.util"

local BASE_MARKER_WIDTH = 128
local BASE_MARKER_HEIGHT = 128

go.property("registration_id", "")
go.property("object_id", 0)
go.property("arena_id", "")
go.property("boss_id", "")
go.property("boss_type", "")
go.property("boss_preset", "")
go.property("battle_music", "")
go.property("victory_music", "")
go.property("is_boss_arena", true)
go.property("lock_on_enter", true)
go.property("unlock_on_clear", true)
go.property("camera_lock", false)
go.property("camera_priority", 10)
go.property("phases", 1)
-- Optional inset used when clamping charge endpoints to this arena. A
-- negative value keeps the attack-pattern default.
go.property("charge_edge_padding", -1)
go.property("zone_width", 1024)
go.property("zone_height", 768)
go.property("room_id", "")
go.property("hide_in_game", true)

local AUTHORED_SCHEMA = {
    object_kind = "boss_arena",
    hash_fields = {
        "arena_id",
        "boss_id",
        "boss_type",
        "boss_preset",
        "battle_music",
        "victory_music",
    },
    optional_hash_fields = { "battle_music", "victory_music" },
    number_fields = {
        "camera_priority",
        "phases",
        "charge_edge_padding",
    },
    bool_fields = {
        "is_boss_arena",
        "lock_on_enter",
        "unlock_on_clear",
        "camera_lock",
    },
}

local function resolve_zone_dimensions(self)
    local scale = go.get_scale()
    local scale_x = math.abs(tonumber(scale.x) or 1)
    local scale_y = math.abs(tonumber(scale.y) or 1)

    local width_from_scale = scale_x * BASE_MARKER_WIDTH
    local height_from_scale = scale_y * BASE_MARKER_HEIGHT
    local width_from_props = Proxy.number(self.zone_width, 1024)
    local height_from_props = Proxy.number(self.zone_height, 768)

    local width = width_from_props
    local height = height_from_props

    if math.abs(scale_x - 1) > 0.001 or math.abs(width_from_scale - width_from_props) < 0.001 then
        width = width_from_scale
    end
    if math.abs(scale_y - 1) > 0.001 or math.abs(height_from_scale - height_from_props) < 0.001 then
        height = height_from_scale
    end

    return width, height
end

local function build_properties(self, room_id)
    local zone_width, zone_height = resolve_zone_dimensions(self)
    local props = {
        arena_id = Proxy.plain(self.arena_id, ""),
        boss_id = Proxy.plain(self.boss_id, ""),
        boss_type = Proxy.plain(self.boss_type, ""),
        boss_preset = Proxy.plain(self.boss_preset, ""),
        battle_music = Proxy.optional_plain(self.battle_music),
        victory_music = Proxy.optional_plain(self.victory_music),
        is_boss_arena = Proxy.bool(self.is_boss_arena, true),
        lock_on_enter = Proxy.bool(self.lock_on_enter, true),
        unlock_on_clear = Proxy.bool(self.unlock_on_clear, true),
        camera_lock = Proxy.bool(self.camera_lock, false),
        camera_priority = Proxy.number(self.camera_priority, 10),
        phases = Proxy.number(self.phases, 1),
        charge_edge_padding = Proxy.number(self.charge_edge_padding, -1),
        zone_width = zone_width,
        zone_height = zone_height,
    }
    props = Proxy.overlay_authored(self, props, AUTHORED_SCHEMA)
    if props.arena_id == "" then
        props.arena_id = room_id ~= "" and ("arena_" .. room_id) or Proxy.registration_id(self, "boss_arena")
    end
    return props
end

local function setup_arena(props, room_id, pos)
    local ok_mod, BossArena = pcall(require, "mvtk.bosses.boss_arena")
    if not (ok_mod and BossArena and BossArena.create_from_tiled and BossArena.setup_arena) then
        return
    end

    local ok_cfg, config = pcall(BossArena.create_from_tiled, {
        arena_id = props.arena_id,
        boss_id = props.boss_id,
        boss_type = props.boss_preset ~= "" and props.boss_preset or props.boss_type,
        battle_music = props.battle_music,
        victory_music = props.victory_music,
        is_boss_arena = props.is_boss_arena,
        lock_on_enter = props.lock_on_enter,
        unlock_on_clear = props.unlock_on_clear,
        camera_lock = props.camera_lock,
        phases = props.phases,
        charge_edge_padding = props.charge_edge_padding,
    })
    if not (ok_cfg and type(config) == "table") then
        return
    end

    local bounds = {
        x = pos.x - props.zone_width * 0.5,
        y = pos.y - props.zone_height * 0.5,
        width = props.zone_width,
        height = props.zone_height,
    }
    config.bounds = bounds
    config.room_id = room_id
    config.boss_id = props.boss_id ~= "" and props.boss_id or config.boss_id
    if props.boss_preset ~= "" then
        config.boss_type = props.boss_preset
    elseif props.boss_type ~= "" then
        config.boss_type = props.boss_type
    end
    pcall(BossArena.setup_arena, props.arena_id, config)
end

function init(self)
    if self.hide_in_game then
        -- Recorded so a room hide/show keeps the marker's collider off.
        pcall(Util.post_component_enabled, "#co", false)
    end

    local room_id = Proxy.room_id(self)
    local pos = Proxy.world_position()
    local props = build_properties(self, room_id)
    if props.boss_preset == "" then
        props.boss_preset = props.boss_type
    end
    props.boss_type = props.boss_preset ~= "" and props.boss_preset or props.boss_type

    -- TriggerZones interprets zone.position as the lower-left corner. Tiled
    -- bakes arena markers at their center, so convert once for every runtime
    -- zone registration while retaining the center for BossArena setup.
    local zone_position = vmath.vector3(
        pos.x - props.zone_width * 0.5,
        pos.y - props.zone_height * 0.5,
        pos.z)

    setup_arena(props, room_id, pos)

    Proxy.post_to_main("register_camera_zone", {
        id = props.arena_id ~= "" and props.arena_id or Proxy.registration_id(self, "boss_camera"),
        position = zone_position,
        width = props.zone_width,
        height = props.zone_height,
        room_id = room_id,
        camera_mode = props.camera_lock and "fixed" or "follow",
        arena_auto_fit = props.camera_lock,
        fit_padding = 0,
        priority = props.camera_priority,
    })

    Proxy.post_to_main("register_arena_lock", {
        id = Proxy.registration_id(self, props.arena_id),
        arena_id = props.arena_id,
        position = zone_position,
        width = props.zone_width,
        height = props.zone_height,
        room_id = room_id,
        lock_on_enter = props.lock_on_enter,
        unlock_on_clear = props.unlock_on_clear,
        boss_id = props.boss_id,
        boss_preset = props.boss_preset,
        boss_type = props.boss_type,
        charge_edge_padding = props.charge_edge_padding,
        is_boss_arena = true,
        properties = props,
    })
end
