-- mvtk/prefabs/wall_jump_surface.script
-- ============================================================================
-- WALL JUMP SURFACE (Climbable Wall)
-- ============================================================================
-- A surface that allows the player to wall jump and/or wall slide.
-- Place these on walls where you want to enable wall mechanics.
--
-- TILED PROPERTIES:
--   allow_slide     - Player can slide down this wall (reduces fall speed)
--   allow_jump      - Player can wall jump off this surface
--   allow_climb     - Player can climb up/down (requires wall_climb ability)
--   slide_speed     - Fall speed multiplier when sliding (0.3 = 30% normal)
--   jump_force_x    - Horizontal force when wall jumping
--   jump_force_y    - Vertical force when wall jumping
--   facing          - Which direction this wall faces (1 = right, -1 = left)
--   require_ability - Ability text ID required to use (empty = always usable)
--   surface_type    - Visual/audio type (stone, ice, vine, metal)
--
-- CONFIGURATION:
--   All values come from Tiled properties.
--   DO NOT hardcode values here.
-- ============================================================================

local C = require "mvtk.core.constants"
local Util = require "mvtk.core.util"

-- Identity metadata emitted by Create Rooms and visible in the room editor.
go.property("surface_id", "")
go.property("room_id", "")
go.property("allow_slide", true)
go.property("allow_jump", true)
go.property("allow_climb", false)
go.property("slide_speed", 0.3)
go.property("jump_force_x", 400)
go.property("jump_force_y", 500)
go.property("facing", 1)
go.property("require_ability", "")
go.property("surface_type", "stone")
go.property("show_sprite", true) -- false when the Tiled layer owns the visible art

local PLAYER_GROUP = hash("player")

local function resolve_player_target(other_id)
    if other_id and go.exists(other_id) then
        return other_id
    end

    local fallback = C.URL and C.URL.PLAYER
    if fallback and go.exists(fallback) then
        return fallback
    end

    return nil
end

local function post_to_player(other_id, message_id, payload)
    local player_target = resolve_player_target(other_id)
    if player_target then
        Util.safe_post(player_target, message_id, payload)
    end
end

function init(self)
    if not self.show_sprite then
        Util.set_component_enabled("#sprite", false)
    end
    self.player_touching = false
    self.player_id = nil
end

function on_message(self, message_id, message, sender)
    if message_id == hash("trigger_response") then
        if message.group == PLAYER_GROUP then
            if message.enter then
                self.player_touching = true
                self.player_id = message.other_id

                -- Notify player they're touching a wall surface
                post_to_player(message.other_id, hash("wall_surface_enter"), {
                    surface_id = go.get_id(),
                    allow_slide = self.allow_slide,
                    allow_jump = self.allow_jump,
                    allow_climb = self.allow_climb,
                    slide_speed = self.slide_speed,
                    jump_force_x = self.jump_force_x,
                    jump_force_y = self.jump_force_y,
                    facing = self.facing,
                    require_ability = self.require_ability,
                    surface_type = self.surface_type,
                })
            else
                self.player_touching = false
                self.player_id = nil

                -- Notify player they left the wall surface
                post_to_player(message.other_id, hash("wall_surface_exit"), {
                    surface_id = go.get_id(),
                })
            end
        end

    elseif message_id == hash("query_wall_info") then
        -- Player requesting current wall properties
        msg.post(sender, hash("wall_info_response"), {
            surface_id = go.get_id(),
            allow_slide = self.allow_slide,
            allow_jump = self.allow_jump,
            allow_climb = self.allow_climb,
            slide_speed = self.slide_speed,
            jump_force_x = self.jump_force_x,
            jump_force_y = self.jump_force_y,
            facing = self.facing,
            require_ability = self.require_ability,
            surface_type = self.surface_type,
        })

    elseif message_id == hash("apply_tiled_props") then
        local props = message.properties or {}
        if props.allow_slide ~= nil then self.allow_slide = props.allow_slide end
        if props.allow_jump ~= nil then self.allow_jump = props.allow_jump end
        if props.allow_climb ~= nil then self.allow_climb = props.allow_climb end
        if props.slide_speed then self.slide_speed = props.slide_speed end
        if props.jump_force_x then self.jump_force_x = props.jump_force_x end
        if props.jump_force_y then self.jump_force_y = props.jump_force_y end
        if props.facing then self.facing = props.facing end
        if props.direction and type(props.direction) == "string" then
            local dir = props.direction:lower()
            if dir == "left" then
                self.facing = -1
            elseif dir == "right" then
                self.facing = 1
            elseif dir == "both" then
                self.facing = 0
            end
        end
        if props.require_ability or props.requires_ability then
            local value = props.require_ability or props.requires_ability
            self.require_ability = value
        end
        if props.surface_type then
            self.surface_type = props.surface_type
        end
    end
end
