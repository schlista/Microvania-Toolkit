-- mvtk/prefabs/boss_weak_point.script
-- Targetable weak point that applies bonus damage to a boss.

local PU = require "mvtk.prefabs.prefab_utils"
local BossManagerOk, BossManager = pcall(require, "mvtk.bosses.boss_manager")
local Flags = require "mvtk.core.flags"
local Util = require "mvtk.core.util"
local CombatFeedback = require "mvtk.combat.combat_feedback"
local Presentation = require "mvtk.tiled.object_presentation"

local ATTACK_GROUP = hash("attack")
local DamagePayload = require "mvtk.combat.damage_payload"

local function to_bool(value, default)
    if value == nil then return default end
    if type(value) == "boolean" then return value end
    if type(value) == "string" then
        local v = value:lower()
        if v == "true" or v == "1" or v == "yes" then return true end
        if v == "false" or v == "0" or v == "no" then return false end
    end
    return default
end

local function parse_phase_set(value)
    local set = {}
    if type(value) == "string" then
        for phase in string.gmatch(value, "(%d+)") do
            set[tonumber(phase)] = true
        end
    end
    return set
end

go.property("room_id", "") -- Room ownership emitted by Create Rooms.
go.property("boss_id", "")
go.property("boss_type", "")
go.property("point_id", "")
go.property("damage_mult", 2.0)
go.property("health", 0)
go.property("exposed_in_phase", 1)
go.property("hidden_in_phase", 0)
go.property("active_phases", "")
go.property("vulnerable", true)
go.property("destroy_flag", "")
go.property("requires_flag", "")

go.property("poll_interval", 0.2)
-- Follow the boss, keeping the authored offset from where the boss spawned.
go.property("attach_to_boss", true)

go.property("show_sprite", true)

local function resolve_boss_id(self)
    if not (BossManagerOk and BossManager) then return nil end
    if BossManager.find_boss_id then
        return BossManager.find_boss_id({
            boss_id = self.boss_id_str,
            boss_tag = self.boss_id_str,
            boss_type = self.boss_type_str,
        })
    end
    if self.boss_id_str ~= "" and BossManager.get_boss and BossManager.get_boss(self.boss_id_str) then
        return self.boss_id_str
    end
    return nil
end

local function current_phase(self)
    if not (BossManagerOk and BossManager) then return 0 end
    local boss_id = resolve_boss_id(self)
    if not boss_id then return 0 end
    self._boss_id = boss_id
    return BossManager.get_boss_phase and BossManager.get_boss_phase(boss_id) or 1
end

local function set_visible(self, enabled)
    if self._visible == enabled then
        return
    end
    self._visible = enabled
    Presentation.visible(enabled)
    if enabled then
        Util.post_component_enabled("#co", true)
        if self.show_sprite ~= false then
            Util.set_component_enabled("#sprite", true)
        end
    else
        Util.post_component_enabled("#co", false)
        if self.show_sprite ~= false then
            Util.set_component_enabled("#sprite", false)
        end
    end
end

local function evaluate_visibility(self, phase)
    if self.requires_flag_str ~= "" and not Flags.has(self.requires_flag_str) then
        return false
    end

    if next(self.active_phase_set) then
        return self.active_phase_set[phase] or false
    end

    local exposed_in = tonumber(self.exposed_in_phase) or 1
    local hidden_in = tonumber(self.hidden_in_phase) or 0
    if hidden_in > 0 and phase >= hidden_in then
        return false
    end
    if exposed_in > 0 and phase < exposed_in then
        return false
    end

    return phase > 0
end

local function apply_damage(self, amount, source)
    if require("mvtk.core.pause").get() then return end
    if not (self.vulnerable == true) then
        return
    end

    local dmg = tonumber(amount) or 1
    local mult = tonumber(self.damage_mult) or 1.0
    local final_damage = math.max(1, math.floor(dmg * mult + 0.5))

    if self.health and self.health > 0 then
        self.health = self.health - final_damage
        if self.health <= 0 then
            if self.destroy_flag_str ~= "" then
                Flags.set(self.destroy_flag_str, true)
            end
            set_visible(self, false)
            go.delete()
        end
    end

    if BossManagerOk and BossManager and self._boss_id and BossManager.damage_boss then
        BossManager.damage_boss(self._boss_id, final_damage, source or self.point_id_str)
    end

    -- Show the multiplied hit so the weak point's purpose is readable.
    local ok_feel, Feel = pcall(require, "mvtk.core.gamefeel")
    if ok_feel and Feel and Feel.damage_number then
        pcall(Feel.damage_number, final_damage, go.get_world_position(), { target = "enemy", crit = true })
    end
end

-- Keep this weak point at (boss position + authored offset). The offset is
-- captured the first time the live boss is seen, while it stands at its spawn.
local function follow_boss(self)
    if not self.attach_to_boss or not self._boss_id then return end
    if not (BossManagerOk and BossManager and BossManager.get_boss) then return end
    local boss = BossManager.get_boss(self._boss_id)
    local url = boss and boss.go_url
    if not url or not go.exists(url) then return end
    local boss_pos = go.get_world_position(url)
    local my_pos = go.get_world_position()
    if not self._attach_offset then
        self._attach_offset = my_pos - (boss.spawn_position or boss.position or boss_pos)
    end
    local target = boss_pos + self._attach_offset
    target.z = boss_pos.z + 0.002
    local delta = target - my_pos
    if delta.x ~= 0 or delta.y ~= 0 or delta.z ~= 0 then
        -- Delta keeps this correct whether or not the instance has a parent.
        go.set_position(go.get_position() + delta)
    end
end

local function apply_props(self, props)
    props = props or {}
    if props.boss_id ~= nil then self.boss_id_str = tostring(props.boss_id) end
    if props.boss_type ~= nil then self.boss_type_str = tostring(props.boss_type) end
    if props.point_id ~= nil then self.point_id_str = tostring(props.point_id) end
    if props.damage_mult ~= nil then self.damage_mult = tonumber(props.damage_mult) or self.damage_mult end
    if props.health ~= nil then self.health = tonumber(props.health) or self.health end
    if props.exposed_in_phase ~= nil then self.exposed_in_phase = tonumber(props.exposed_in_phase) or self.exposed_in_phase end
    if props.hidden_in_phase ~= nil then self.hidden_in_phase = tonumber(props.hidden_in_phase) or self.hidden_in_phase end
    if props.active_phases ~= nil then self.active_phases_str = tostring(props.active_phases) end
    if props.vulnerable ~= nil then self.vulnerable = to_bool(props.vulnerable, self.vulnerable) end
    if props.destroy_flag ~= nil then self.destroy_flag_str = tostring(props.destroy_flag) end
    if props.requires_flag ~= nil then self.requires_flag_str = tostring(props.requires_flag) end
    if props.poll_interval ~= nil then self.poll_interval = tonumber(props.poll_interval) or self.poll_interval end
    if props.show_sprite ~= nil then self.show_sprite = to_bool(props.show_sprite, self.show_sprite) end
    if props.attach_to_boss ~= nil then self.attach_to_boss = to_bool(props.attach_to_boss, self.attach_to_boss) end
    self.active_phase_set = parse_phase_set(self.active_phases_str or "")
end

function init(self)
    CombatFeedback.set_target_owner(go.get_id(), true)
    self.boss_id_str = PU.normalize_hash_string(self.boss_id) or ""
    self.boss_type_str = PU.normalize_hash_string(self.boss_type) or ""
    self.point_id_str = PU.normalize_hash_string(self.point_id) or tostring(go.get_id())
    self.active_phases_str = PU.normalize_hash_string(self.active_phases) or ""
    self.destroy_flag_str = PU.normalize_hash_string(self.destroy_flag) or ""
    self.requires_flag_str = PU.normalize_hash_string(self.requires_flag) or ""
    self.active_phase_set = parse_phase_set(self.active_phases_str)

    self._visible = nil
    self._poll_t = 0
    set_visible(self, false)
end

function update(self, dt)
    if require("mvtk.core.pause").get() then return end
    follow_boss(self)
    self._poll_t = (self._poll_t or 0) - dt
    if self._poll_t > 0 then
        return
    end
    self._poll_t = tonumber(self.poll_interval) or 0.2

    local phase = current_phase(self)
    local should_show = evaluate_visibility(self, phase)
    set_visible(self, should_show)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("apply_tiled_props") and message and message.properties then
        apply_props(self, message.properties)
        return
    end

    if message_id == hash("mvtk_apply_damage") and message then
        local incoming = DamagePayload.normalize(message, sender)
        apply_damage(self, incoming.amount or 1, incoming.source_actor or incoming.source)
        return
    end

    if message_id == hash("trigger_response") then
        if message.enter then
            local g = message.group or message.other_group or message.own_group
            if g == ATTACK_GROUP then
                local dmg = 1
                local ok_dmg, dmg_val = pcall(go.get, message.other_id, "damage")
                if ok_dmg and type(dmg_val) == "number" then dmg = dmg_val end
                apply_damage(self, dmg, message.other_id)
            end
        end
        return
    end

    if message_id == hash("contact_point_response") then
        if message.group == ATTACK_GROUP or message.other_group == ATTACK_GROUP then
            local dmg = 1
            local ok_dmg, dmg_val = pcall(go.get, message.other_id, "damage")
            if ok_dmg and type(dmg_val) == "number" then dmg = dmg_val end
            apply_damage(self, dmg, message.other_id)
        end
        return
    end
end

function final(self)
    CombatFeedback.set_target_owner(go.get_id(), false)
end
