local EnemySkinSync = require "mvtk.enemies.enemy_skin_sync"
local Debug = require "developer.config.debug_config"
local raw_print = print
local ENEMY_LOG_ENABLED = (Debug.global and Debug.global.enable) or
  (Debug.enemies and (
    Debug.enemies.ai or Debug.enemies.spawner or Debug.enemies.behavior))
local function print(...)
  if ENEMY_LOG_ENABLED then
    raw_print(...)
  end
end
local EnemySkins = Util.require_config("developer.config.enemy_skins_generated", { skins = {} })
if type(EnemySkins.skins) ~= "table" then
  EnemySkins = { skins = {} }
end
local DEFAULT_SKIN = EnemySkinSync.DEFAULT_SKIN or "default"
local ENEMY_CRASH_DEBUG = Debug.global and Debug.global.enable and Debug.enemy_crash or nil

local function enemy_crash_enabled(flag)
  return ENEMY_CRASH_DEBUG and ENEMY_CRASH_DEBUG[flag] == true
end

local function set_enemy_hflip(self)
  if not enemy_crash_enabled("disable_hflip") then
    pcall(sprite.set_hflip, "#sprite", self.facing < 0)
  end
end

-- Room bounds cache: { [room_id] = {min_x, max_x, min_y, max_y} }
local room_bounds_cache = {}
local room_bounds_loaded = false

local function get_room_bounds(room_id)
  if not room_id or room_id == "" then return nil end
  if room_bounds_cache[room_id] then return room_bounds_cache[room_id] end
  if not room_bounds_loaded then
    room_bounds_loaded = true
    local layout = RuntimeLayoutLoader.load()
    if layout and layout.rooms then
      for _, room in ipairs(layout.rooms) do
        local id = room.id
        if id then
          local x  = tonumber(room.x) or 0
          local y  = tonumber(room.y) or 0
          local w  = tonumber(room.w) or 0
          local h  = tonumber(room.h) or 0
          local ox = tonumber(room.ox) or 0
          local oy = tonumber(room.oy) or 0
          room_bounds_cache[id] = {
            min_x = x + ox,
            max_x = x + ox + w,
            min_y = y + oy,
            max_y = y + oy + h,
          }
        end
      end
    end
  end
  return room_bounds_cache[room_id]
end

