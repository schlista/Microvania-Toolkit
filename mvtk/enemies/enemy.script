local function trim(s)
  if not s then return "" end
  return (tostring(s):match("^%s*(.-)%s*$"))
end

local function resolve_enemy_type(enemy_type)
  if not enemy_type or enemy_type == "" then
    return nil
  end
  local resolved_key = EnemyOverrides.resolve_enemy_type(enemy_type)
  local key = Util.normalize_hash_string(resolved_key or enemy_type)
  if not key then return nil end
  local ok_mgr, EnemyMgr = pcall(require, "mvtk.enemies.enemy_manager")
  if ok_mgr and EnemyMgr and EnemyMgr.get_enemy_type then
    local cfg = EnemyMgr.get_enemy_type(key)
    if cfg then
      return cfg
    end
  end
  if EnemyTypes == nil then
    local ok, cfg = pcall(require, "developer.config.enemy_types")
    EnemyTypes = ok and cfg or false
  end
  if EnemyTypes and type(EnemyTypes) == "table" then
    return EnemyTypeOverlay.resolve(key, EnemyTypes, EnemySkins, {
      cache = EnemyTypeOverlayCache,
      logger = function(message)
        print("[ENEMY] " .. tostring(message))
      end,
    })
  end
  return nil
end

local value_to_string = Util.normalize_hash_string

local function optional_key(value)
  local s = value_to_string(value)
  if not s then return nil end
  if s:lower() == "none" then return nil end
  return s
end

local ANIM_STATES = {
  "idle", "walk", "run", "jump", "fall", "attack", "ranged_attack", "hurt", "death", "aim", "charge"
}

local ANIM_CONFIG_KEYS = {
  idle = "animation_idle",
  walk = "animation_walk",
  run = "animation_run",
  jump = "animation_jump",
  fall = "animation_fall",
  attack = "animation_attack",
  ranged_attack = "animation_ranged_attack",
  hurt = "animation_hurt",
  death = "animation_death",
  aim = "animation_aim",
  charge = "animation_charge",
}

local function get_skin_config(skin_id)
  local skins = EnemySkins and EnemySkins.skins or nil
  if type(skins) ~= "table" then return nil end
  return skins[skin_id]
end

local function skin_has_state(skin_id, state)
  local skin = get_skin_config(skin_id)
  local states = skin and skin.states or nil
  return type(states) == "table" and states[state] == true
end

local function resolve_active_skin(self, cfg)
  cfg = cfg or {}
  local requested = optional_key(cfg.skin)
  self._requested_skin = requested
  local resolved, _, missing_requested = EnemySkinSync.resolve_active_skin_id(requested, EnemySkins, DEFAULT_SKIN)
  if missing_requested and self._missing_skin_warning ~= requested then
    if resolved then
      print(string.format("[ENEMY] Warning: requested skin '%s' is not synced; using '%s' enemy skin.", tostring(requested), tostring(resolved)))
    else
      print(string.format("[ENEMY] Warning: requested skin '%s' is not synced and no default enemy skin is available.", tostring(requested)))
    end
    self._missing_skin_warning = requested
  end
  return resolved
end

local function apply_enemy_tint(self, cfg)
  cfg = cfg or self.enemy_type_config or {}
  if enemy_crash_enabled("disable_tint_set") then
    return
  end
  if self.skin then
    if cfg.tint_skinned and cfg.color then
      pcall(go.set, "#sprite", "tint", cfg.color)
    end
  elseif cfg.color then
    pcall(go.set, "#sprite", "tint", cfg.color)
  end
end

local function rebuild_anim_map(self, cfg)
  cfg = cfg or self.enemy_type_config or {}
  self.skin = resolve_active_skin(self, cfg)
  self.anim_map = {}
  local skin_config = self.skin and get_skin_config(self.skin) or nil
  local skin_states = skin_config and skin_config.states or nil
  if self.skin and type(skin_states) == "table" then
    for state, enabled in pairs(skin_states) do
      if enabled then
        self.anim_map[state] = self.skin .. "__" .. state
      end
    end
  end
  for _, state in ipairs(ANIM_STATES) do
    local cfg_key = ANIM_CONFIG_KEYS[state]
    local preset = cfg_key and optional_key(cfg[cfg_key]) or nil
    if state == "hurt" and not preset then
      preset = optional_key(cfg.animation_hit)
    end
    local base = preset or state
    if self.skin and type(skin_states) == "table" then
      local resolved_state = EnemyLocomotion.resolve_state(skin_states, base)
      if resolved_state then
        self.anim_map[state] = self.skin .. "__" .. resolved_state
      else
        self.anim_map[state] = base
      end
    else
      self.anim_map[state] = base
    end
  end
end

local function compute_locomotion_profile(self)
  local skin_config = self.skin and get_skin_config(self.skin) or nil
  local profile = EnemyLocomotion.compute_profile(skin_config and skin_config.states or nil, self._uses_run_animation)
  self._loco_move_state = profile.move
  self._loco_idle_state = profile.idle
  return profile
end

local function configure_anim_default(self)
  local idle_state = self._loco_idle_state or "idle"
  local idle = (self.anim_map and (self.anim_map[idle_state] or self.anim_map.idle)) or idle_state
  pcall(msg.post, "#anim", MSG_ANIM_CONFIGURE_VISUAL, { default_state = idle })
end

local function set_anim_state(self, state, once)
  state = state or "idle"
  local resolved = optional_key(self.anim_map and self.anim_map[state]) or state
  if once then
    if self._anim_locked and self._anim_lock_state == state then
      return
    end
    self._anim_locked = true
    self._anim_lock_state = state
    self._current_loop_anim = nil
    pcall(msg.post, "#anim", MSG_ANIM_PLAY_ONCE, { state = resolved })
    return
  end
  if self._dying or self._anim_locked then
    return
  end
  if self._current_loop_anim == resolved then
    return
  end
  self._current_loop_anim = resolved
  pcall(msg.post, "#anim", MSG_ANIM_SET_STATE, { state = resolved })
end

local function apply_enemy_animation_config(self, cfg)
  rebuild_anim_map(self, cfg)
  compute_locomotion_profile(self)
  apply_enemy_tint(self, cfg)
  configure_anim_default(self)
  set_anim_state(self, self._loco_idle_state or "idle", false)
end

local ATTACK_ANIM_PREFS = {
  shoot_straight = { "ranged_attack", "attack" },
  shoot_spread = { "ranged_attack", "attack" },
  shoot_burst = { "ranged_attack", "attack" },
  shoot_circle = { "ranged_attack", "attack" },
  shoot_random = { "ranged_attack", "attack" },
  spiral_shot = { "ranged_attack", "attack" },
  homing_shot = { "ranged_attack", "attack" },
  rain_attack = { "ranged_attack", "attack" },
  shoot = { "ranged_attack", "attack" },
  ranged = { "ranged_attack", "attack" },
  spread = { "ranged_attack", "attack" },
  burst = { "ranged_attack", "attack" },
  circle = { "ranged_attack", "attack" },
  random = { "ranged_attack", "attack" },
  spiral = { "ranged_attack", "attack" },
  homing = { "ranged_attack", "attack" },
  swoop_attack = { "attack", "charge" },
  swoop = { "attack", "charge" },
  dart = { "attack", "charge" },
  melee_swipe = { "attack", "attack_alt" },
  swipe = { "attack", "attack_alt" },
  melee = { "attack", "attack_alt" },
  dash_attack = { "charge", "attack" },
  charge_shoot = { "charge", "ranged_attack", "attack" },
  dash = { "charge", "attack" },
  charge = { "charge", "attack" },
  lunge = { "charge", "attack" },
}

local function attack_anim_state_available(self, state)
  if not self.skin then
    return true
  end
  return skin_has_state(self.skin, state)
end

local function choose_attack_anim_state(self, attack_pattern)
  local attack = optional_key(attack_pattern)
    or optional_key(self.attack_pattern_override)
    or optional_key(self.attack_pattern2_override)
  attack = attack and attack:lower() or nil
  local prefs = ATTACK_ANIM_PREFS[attack] or { "attack" }
  for _, state in ipairs(prefs) do
    if attack_anim_state_available(self, state) then
      return state
    end
  end
  return "attack"
end

local function play_enemy_attack_animation(self, state)
  set_anim_state(self, state or choose_attack_anim_state(self), true)
end

local function update_locomotion_animation(self, vx, vy)
  if self._dying or self._anim_locked then
    return
  end
  if not self._loco_move_state or not self._loco_idle_state then
    compute_locomotion_profile(self)
  end
  vx = vx or 0
  vy = vy or 0
  if (vx * vx + vy * vy) > 1 then
    if vx ~= 0 then
      self.facing = (vx >= 0) and 1 or -1
      set_enemy_hflip(self)
      pcall(msg.post, "#anim", MSG_ANIM_SET_FACING, { dir = self.facing })
    end
    set_anim_state(self, self._loco_move_state or "walk", false)
  else
    set_anim_state(self, self._loco_idle_state or "idle", false)
  end
end

local function apply_enemy_type_config(self, enemy_type)
  local cfg = resolve_enemy_type(enemy_type)
  if not cfg then
    return false
  end
  self.enemy_type_config = cfg
  self._audio = EnemyAudio.resolve(cfg.audio)
  if cfg.health then
    self.max_health = tonumber(cfg.health) or self.max_health
    self.health = self.max_health
  end
  if cfg.speed then
    self.speed = tonumber(cfg.speed) or self.speed
  end
  if cfg.contact_damage or cfg.damage then
    self.contact_damage = tonumber(cfg.contact_damage or cfg.damage) or self.contact_damage
  end
  if cfg.knockback_force then
    self.contact_knockback_px = tonumber(cfg.knockback_force) or self.contact_knockback_px
  end
  if cfg.contact_damage_cooldown then
    self.contact_damage_cooldown = tonumber(cfg.contact_damage_cooldown) or self.contact_damage_cooldown
  end
  if cfg.contact_stun_t then
    self.contact_stun_t = tonumber(cfg.contact_stun_t) or self.contact_stun_t
  end
  if cfg.poise_threshold then
    self.poise_threshold = tonumber(cfg.poise_threshold) or self.poise_threshold
  end
  if cfg.knockback_resistance then
    local res = tonumber(cfg.knockback_resistance) or 0
    if res > 0 then
      self.knockback_mult = math.max(0, 1 - res)
    end
  end
  if cfg.loot_table ~= nil then
    self.loot_table = optional_key(cfg.loot_table)
  end
  if cfg.drops ~= nil then
    if type(cfg.drops) == "table" then
      self.drops = cfg.drops
      if next(self.drops) == nil then
        self.loot_table = nil
      end
    else
      local drops_key = value_to_string(cfg.drops)
      if drops_key and drops_key:lower() == "none" then
        self.drops = {}
        self.loot_table = nil
      elseif drops_key then
        self.drops = EnemyOverrides.parse_drops_string(drops_key)
      end
    end
  end
  if cfg.scale then
    local s = tonumber(cfg.scale) or 1
    if s > 0 then
      pcall(go.set_scale, vmath.vector3(s, s, 1))
    end
  end
  apply_enemy_animation_config(self, cfg)
  if cfg.ignores_terrain ~= nil then
    self._ignores_terrain = (cfg.ignores_terrain == true)
  end
  if cfg.grounded_movement ~= nil then
    self._grounded_movement = (cfg.grounded_movement == true)
  end
  self._ledge = LedgeGuard.settings(cfg, EnemyDefaults, TileSettings)
  if cfg.detection_range then
    self._detection_range = tonumber(cfg.detection_range) or 200
  end
  if cfg.chase_speed then
    self.chase_speed = tonumber(cfg.chase_speed) or self.chase_speed
  end
  if cfg.chase_speed_mult then
    self._chase_speed_mult = tonumber(cfg.chase_speed_mult) or 1.0
  end
  if cfg.patrol_distance then
    local patrol_distance = tonumber(cfg.patrol_distance)
    if patrol_distance then
      self.patrol_distance = patrol_distance
      self.patrol_width = patrol_distance * 0.5
    end
  end
  if cfg.hover_height then
    local hover_height = tonumber(cfg.hover_height)
    if hover_height then
      self.hover_height = hover_height
      self.patrol_height = hover_height
    end
  end
  if cfg.shoot_cooldown then
    self.shoot_cooldown = tonumber(cfg.shoot_cooldown) or self.shoot_cooldown
  end
  if cfg.projectile_speed then
    self.projectile_speed = tonumber(cfg.projectile_speed) or self.projectile_speed
  end
  if cfg.projectile_visual then
    self.projectile_visual = optional_key(cfg.projectile_visual) or self.projectile_visual
  end
  if cfg.charge_speed then
    self.charge_speed = tonumber(cfg.charge_speed) or self.charge_speed
  end
  local numeric_tuning_keys = {
    "projectile_damage",
    "charge_distance", "charge_duration", "charge_cooldown",
    "attack_detection_range",
    "swoop_detection_range", "swoop_speed", "swoop_duration",
    "dart_speed", "dart_interval", "dart_vertical_speed",
    "rise_range", "rise_height", "rise_speed",
    "attack_range", "attack_height", "attack_windup", "attack_cooldown",
  }
  for _, tuning_key in ipairs(numeric_tuning_keys) do
    if cfg[tuning_key] ~= nil then
      local value = tonumber(cfg[tuning_key])
      if value ~= nil then
        self[tuning_key] = value
      end
    end
  end
  return true
end

