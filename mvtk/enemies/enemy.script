local RuntimeSettings = require "developer.config.runtime_settings"
local RuntimeLayoutLoader = require "mvtk.rooms.runtime_layout_loader"
local TiledPaths = require "mvtk.tiled.tiled_paths"
-- Util.require_config, not pcall(require, ...): the manifest is only reachable
-- through this call, so a bare require never gets bundled into the build —
-- require_config falls back to sys.load_resource via custom_resources
-- (/developer/config), same as the music manifest in room_manager.
local Util = require "mvtk.core.util"
local Audio = require "mvtk.audio.audio"
local EnemyAudio = require "mvtk.enemies.enemy_audio"
local EnemyTypeOverlay = require "mvtk.enemies.enemy_type_overlay"
